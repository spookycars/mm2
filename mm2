local function getGunOrigin(gun)
    if not gun then return nil end
    local handle = gun:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then return handle.Position end
    return nil
end
local function getPredictedMurdererTargetPos(targetChar)
    if not targetChar then return nil end
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local gun = myChar:FindFirstChild("Gun")
    local origin = getGunOrigin(gun)
    if not origin then
        local handle = myChar:FindFirstChild("Handle", true)
        if handle and handle:IsA("BasePart") then origin = handle.Position
        else
            local myHrp = myChar:FindFirstChild("HumanoidRootPart")
            if not myHrp then return nil end
            origin = myHrp.Position
        end
    end
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return nil end
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {myChar, Camera}
    local velocity = targetHrp.AssemblyLinearVelocity or Vector3.zero
    local currentPing = getPing()
    local leadTime = math.clamp(currentPing * 0.35, 0.005, 0.06)
    local partsToCheck = {"HumanoidRootPart", "UpperTorso", "Torso", "LowerTorso", "Head"}
    for _, partName in ipairs(partsToCheck) do
        local part = targetChar:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local predictedPos = part.Position + (velocity * leadTime)
            local direction = predictedPos - origin
            local result = Workspace:Raycast(origin, direction, raycastParams)
            if result and result.Instance and result.Instance:IsDescendantOf(targetChar) then
                return predictedPos
            end
        end
    end
    for _, partName in ipairs(partsToCheck) do
        local part = targetChar:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            local currentPos = part.Position
            local direction = currentPos - origin
            local result = Workspace:Raycast(origin, direction, raycastParams)
            if result and result.Instance and result.Instance:IsDescendantOf(targetChar) then
                return currentPos
            end
        end
    end
    return nil
end
local function shootAtVector3(targetVector3)
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local gun = myChar:FindFirstChild("Gun")
    if not gun then return end
    local originPos = getGunOrigin(gun)
    if not originPos then return end
    local cframe1 = CFrame.new(originPos, targetVector3)
    local cframe2 = CFrame.new(targetVector3)
    local gunServer = gun:FindFirstChild("GunServer")
    local shootRemote = (gunServer and (gunServer:FindFirstChild("Shoot") or gunServer:FindFirstChild("ShootStart")))
        or gun:FindFirstChild("Shoot", true)
        or gun:FindFirstChild("ShootStart", true)
    if shootRemote and shootRemote:IsA("RemoteEvent") then
        shootRemote:FireServer(cframe1, cframe2)
    end
end

