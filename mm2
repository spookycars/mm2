-- ===================== OBSTACLE JUMP (correct logic) =====================
-- The question is: "Is there a low obstacle directly in front that I can
-- physically clear by jumping?"

-- The conditions are INDEPENDENT:
--   1. There IS an obstacle ahead at chest height (ray forward hits something)
--   2. The TOP of that obstacle is only 1-3 studs above my feet (low enough to
--      jump over — the humanoid jump clears ~5-6 studs so anything under 3 is
--      safe)
--   3. There IS floor on the other side of the obstacle (not a cliff)
--   4. There is NO ceiling within jump height above my head (else I hit it)

-- Note: an overhead ceiling above the OBSTACLE is completely fine — the
-- obstacle's own top is what we're jumping OVER, not under.
local function shouldJumpOverObstacle(char, hum, myRoot, moveTarget)
    if not moveTarget then return false end
    local myPos = myRoot.Position
    local toTarget = moveTarget - myPos
    toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    if toTarget.Magnitude < 0.5 then return false end
    local dir = toTarget.Unit
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {char, Camera}

    -- Condition 4: is there head-clearance to jump? If a ceiling is within
    -- ~8 studs of my head, jumping would bang into it.
    local headStart = myPos + Vector3.new(0, 5, 0)
    local headHit = workspace:Raycast(headStart, Vector3.new(0, 8, 0), rayParams)
    if headHit then return false end

    -- Condition 1: obstacle ahead
    local chestStart = myPos + Vector3.new(0, 2.5, 0)
    local hit = workspace:Raycast(chestStart, dir * 2.5, rayParams)
    if not hit or not hit.Instance then return false end
    if hit.Instance.CanCollide == false then return false end

    -- Condition 2: how tall is the obstacle?
    local topProbeStart = hit.Position + Vector3.new(0, 8, 0)
    local topHit = workspace:Raycast(topProbeStart, Vector3.new(0, -12, 0), rayParams)
    if not topHit then return false end
    local obstacleHeight = topHit.Position.Y - myPos.Y
    -- Only jump over genuinely LOW obstacles (steps, small boxes, curbs)
    if obstacleHeight > 3 then return false end

    -- Condition 3: landing floor beyond the obstacle
    local beyondStart = hit.Position + dir * 2 + Vector3.new(0, 3, 0)
    local floorBeyond = workspace:Raycast(beyondStart, Vector3.new(0, -8, 0), rayParams)
    if not floorBeyond then return false end

    return true
end

local function executeWaypointPath(char, hum, myRoot, waypoints, waypointIndex, now)
    local myPos = myRoot.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {char}
    local eyePos = myPos + Vector3.new(0, 2.5, 0)

    while waypointIndex <= #waypoints do
        local wp = waypoints[waypointIndex]
        local diff = myPos - wp.Position
        local horiz = Vector3.new(diff.X, 0, diff.Z).Magnitude
        local vert = math.abs(diff.Y)
        if wp.Action == Enum.PathWaypointAction.Jump then
            local alreadyJumped = (now - pathState.lastJumpTime) < 0.6
            if alreadyJumped and (myPos.Y >= wp.Position.Y - 2 or horiz <= 2) then
                waypointIndex = waypointIndex + 1
            else
                break
            end
        else
            if horiz <= 3 and vert <= 5 then
                waypointIndex = waypointIndex + 1
            else
                break
            end
        end
    end

    if waypointIndex > #waypoints then return "arrived", waypointIndex end

    for i = waypointIndex, math.min(waypointIndex + 1, #waypoints) do
        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then
            local horizDist = Vector3.new(wp.Position.X - myPos.X, 0, wp.Position.Z - myPos.Z).Magnitude
            if horizDist <= 6 and (now - pathState.lastJumpTime) > 0.4 then
                hum.Jump = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                pathState.lastJumpTime = now
                return "walking", waypointIndex
            end
            break
        end
    end

    local steerIdx = waypointIndex
    for i = waypointIndex + 1, math.min(waypointIndex + 5, #waypoints) do
        local prevWp = waypoints[i - 1]
        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then break end
        if prevWp.Action == Enum.PathWaypointAction.Jump then break end
        if (wp.Position - myPos).Magnitude > 40 then break end
        if math.abs(wp.Position.Y - myPos.Y) > 6 then break end
        local wpEye = wp.Position + Vector3.new(0, 2.5, 0)
        if workspace:Raycast(eyePos, wpEye - eyePos, rayParams) then break end
        steerIdx = i
    end

    local nextWp = waypoints[steerIdx]
    local climbGap = nextWp.Position.Y - myPos.Y
    if climbGap > 5 then
        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        overlapParams.FilterDescendantsInstances = {char}
        local parts = workspace:GetPartBoundsInRadius(
            myPos + Vector3.new(0, climbGap * 0.5, 0),
            8, overlapParams
        )
        local foundLadder = false
        for _, part in ipairs(parts) do
            local n = string.lower(part.Name)
            if n:find("ladder") or n:find("truss") or n:find("climb") then
                foundLadder = true
                break
            end
        end
        if foundLadder and hum:GetState() ~= Enum.HumanoidStateType.Climbing then
            hum:MoveTo(nextWp.Position)
            hum:ChangeState(Enum.HumanoidStateType.Climbing)
            return "walking", waypointIndex
        end
    end

    if shouldJumpOverObstacle(char, hum, myRoot, nextWp.Position) then
        if (now - pathState.lastJumpTime) > 0.5 then
            hum.Jump = true
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
            pathState.lastJumpTime = now
            return "walking", waypointIndex
        end
    end

    local horizVel = Vector3.new(
        myRoot.AssemblyLinearVelocity.X, 0, myRoot.AssemblyLinearVelocity.Z
    ).Magnitude
    if pathState.lastHorizVel > 4 and horizVel < 1 then
        if (now - pathState.lastJumpTime) > 0.6 then
            if shouldJumpOverObstacle(char, hum, myRoot, nextWp.Position) then
                hum.Jump = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                pathState.lastJumpTime = now
                pathState.lastHorizVel = horizVel
                return "walking", waypointIndex
            end
        end
    end
    pathState.lastHorizVel = horizVel

    hum:MoveTo(waypoints[steerIdx].Position)
    return "walking", waypointIndex
end

