local function stopAutoPlay()
    AutoPlayActive = false
    if autoPlayConnection then
        autoPlayConnection:Disconnect()
        autoPlayConnection = nil
    end
    currentPath = nil
    currentWaypoints = {}
    currentWaypointIndex = 1
end

local function isWaypointReached(humanoid, waypoint, tolerance)
    tolerance = tolerance or 3
    local hrp = humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return (hrp.Position - waypoint.Position).Magnitude <= tolerance
end

local function computePathTo(targetPos)
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,   -- lets the solver mark jump waypoints
        AgentCanClimb = true,  -- lets the solver route over climbable truss parts
        WaypointSpacing = 4,
        Costs = {
            Water = 20,        -- avoid swimming if possible
        }
    })
    -- Keep the solver from running too long on complex maps
    path.CalculationSecondsTimeout = 1

    local success, err = pcall(function()
        path:ComputeAsync(hrp.Position, targetPos)
    end)

    if success and path.Status == Enum.PathStatus.Success then
        return path
    else
        -- Path could not be computed (target unreachable, map issue, etc.)
        return nil
    end
end

local function startMurdererAutoPlay()
    if autoPlayConnection then return end
    AutoPlayActive = true

    autoPlayConnection = RunService.Heartbeat:Connect(function()
        if not AutoPlayActive then return end
        if Murder ~= LocalPlayer.Name then return end -- only act when we are the murderer

        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        local myRoot = char.HumanoidRootPart
        local myPos = myRoot.Position

        -- Find the nearest valid target (same logic as before)
        local target = nil
        local nearest = math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if Config.Helper.SelectedPlayer and player == Config.Helper.SelectedPlayer then continue end
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
            if not IsAlive(player) then continue end
            local dist = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < nearest then
                nearest = dist
                target = player
            end
        end

        if not target then
            hum:MoveTo(myPos) -- stand still
            return
        end

        local targetRoot = target.Character.HumanoidRootPart
        local targetPos = targetRoot.Position
        local distanceToTarget = (myPos - targetPos).Magnitude

        -- If we are already close enough, stop pathfinding and attack.
        if distanceToTarget <= ATTACK_DISTANCE then
            local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
            if knife then
                if knife.Parent ~= char then
                    hum:EquipTool(knife)
                end
                knife:Activate()
            end
            return
        end

        -- Throttle path recomputation: don't spam ComputeAsync every frame
        local now = tick()
        if now - lastPathCompute >= PATH_RECOMPUTE_INTERVAL or not currentPath then
            lastPathCompute = now
            currentPath = computePathTo(targetPos)
            if currentPath then
                currentWaypoints = currentPath:GetWaypoints()
                currentWaypointIndex = 1
            end
        end

        -- If pathfinding failed, fall back to direct movement so we at least
        -- keep pressure on the target instead of freezing.
        if not currentPath or #currentWaypoints == 0 then
            hum:MoveTo(targetPos)
            return
        end

        -- Follow the current waypoint
        local currentWaypoint = currentWaypoints[currentWaypointIndex]
        if not currentWaypoint then
            -- We reached the end of the path; recompute next frame
            currentPath = nil
            return
        end

        -- Handle jump waypoints
        if currentWaypoint.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        -- Handle climb waypoints (custom labels from PathfindingModifiers / Links)
        -- If your map uses a "Climb" label on ladders/trusses, this branch
        -- will walk into the climbable surface. The humanoid will climb it
        -- automatically once it touches the TrussPart.
        if currentWaypoint.Label == "Climb" then
            hum:MoveTo(currentWaypoint.Position)
        else
            hum:MoveTo(currentWaypoint.Position)
        end

        -- Advance the waypoint index when we get close enough.
        -- Tolerance is slightly larger for jump waypoints.
        local tolerance = (currentWaypoint.Action == Enum.PathWaypointAction.Jump) and 4 or 2.5
        if isWaypointReached(hum, currentWaypoint, tolerance) then
            currentWaypointIndex = currentWaypointIndex + 1
        end
    end)
end

-- ===================== HELPER SYSTEM =====================
local alreadyHidThisRound = false
local hideDelayStarted = false
local lastHideNotification = nil
local lastSpectateState = { sheriff = false, murderer = false }
local lastNotifiedPerk = nil
local lastMurderer = nil

local function updateHelper()
    updateRoles()
    local selectedPlayer = Config.Helper.SelectedPlayer
    if selectedPlayer and not selectedPlayer.Parent then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name == selectedPlayer.Name then
                Config.Helper.SelectedPlayer = p
                selectedPlayer = p
                break
            end
        end
        if not selectedPlayer or not selectedPlayer.Parent then
            selectedPlayer = nil
        end
    end

    local selectedIsMurderer = false
    if selectedPlayer then
        local role, _ = getRole(selectedPlayer)
        selectedIsMurderer = (role == "Murderer")
    end

    local localIsMurderer = (Murder == LocalPlayer.Name)
    local localIsSheriff = (Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name)

    -- Auto Player (murderer only)
    if Config.Helper.AutoPlayer then
        if localIsMurderer then
            startMurdererAutoPlay()
        else
            stopAutoPlay()
        end
    else
        stopAutoPlay()
    end

    -- Spectate logic (fixed untoggle)
    local wantSpectateSheriff = Config.Helper.SpectateSheriff and not localIsSheriff
    local wantSpectateMurderer = Config.Helper.SpectateMurderer and not localIsMurderer

    local sheriffPlayer = Players:FindFirstChild(Sheriff)
    local murdererPlayer = Players:FindFirstChild(Murder)

    if wantSpectateSheriff and sheriffPlayer and IsAlive(sheriffPlayer) then
        startSpectating(sheriffPlayer)
        lastSpectateState.sheriff = true
        lastSpectateState.murderer = false
    elseif wantSpectateMurderer and murdererPlayer and IsAlive(murdererPlayer) then
        startSpectating(murdererPlayer)
        lastSpectateState.murderer = true
        lastSpectateState.sheriff = false
    else
        if lastSpectateState.sheriff or lastSpectateState.murderer then
            stopSpectating()
            lastSpectateState.sheriff = false
            lastSpectateState.murderer = false
        end
    end

    -- Auto Grab Gun Near Player (only when selected player is murderer)
    if Config.Helper.AutoGrabGunNearPlayer and selectedIsMurderer then
        local gundrop = Workspace:FindFirstChild("GunDrop", true)
        if gundrop and gundrop:IsA("BasePart") then
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                if selectedPlayer and player == selectedPlayer then continue end
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    if (player.Character.HumanoidRootPart.Position - gundrop.Position).Magnitude <= 10 then
                        autoGrabGun()
                        break
                    end
                end
            end
        end
    end

    -- Notify Murderer Perk
    if Config.ESP.NotifyMurdererPerk then
        if Murder and Murder ~= LocalPlayer.Name then
            if Murder ~= lastMurderer then
                lastMurderer = Murder
                lastNotifiedPerk = nil
            end
            local murdererData = roles[Murder]
            if murdererData then
                local perkName = murdererData.Perk or murdererData.MurdererPerk or murdererData.EquippedPerk
                if perkName and perkName ~= lastNotifiedPerk then
                    lastNotifiedPerk = perkName
                    local murdererPlayer = Players:FindFirstChild(Murder)
                    if murdererPlayer then
                        Notify("Murderer Perk", murdererPlayer.Name .. " has " .. perkName, 6)
                    end
                end
            end
        else
            lastMurderer = nil
            lastNotifiedPerk = nil
        end
    end
end

-- ===================== AUTO SHOOT LOOP =====================
RunService.RenderStepped:Connect(function()
    if not Config.Combat.AutoShootMurderer then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local hasGun = hasTool(LocalPlayer, "Gun")
    local hasKnife = hasTool(LocalPlayer, "Knife")
    if not hasGun or hasKnife then return end

    local murderer = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasTool(player, "Knife") then
            murderer = player
            break
        end
    end

    if not murderer or not murderer.Character or not hasTool(murderer, "Knife") then return end

    -- Auto-equip gun only if not already equipped and not manually unequipped
    if not isEquipped(LocalPlayer, "Gun") and not autoEquippedGun then
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
        if gun then
            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(gun)
                autoEquippedGun = true
                currentGunObject = gun
            end
        else
            autoGrabGun()
        end
        return
    end

    -- If gun is equipped, shoot
    if isEquipped(LocalPlayer, "Gun") then
        local predictedPos = getPredictedMurdererTargetPos(murderer.Character)
        if predictedPos then
            if tick() - lastShotTime >= SHOOT_COOLDOWN then
                lastShotTime = tick()
                shootAtVector3(predictedPos)
            end
        end
    end
end)

-- Reset auto-equip flag when a new gun is acquired
LocalPlayer.Backpack.ChildAdded:Connect(function(child)
    if child.Name == "Gun" and child ~= currentGunObject then
        currentGunObject = child
        autoEquippedGun = false
    end
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    autoEquippedGun = false
    currentGunObject = nil
end)

