-- Spawn Point Checker
-- Standalone script — just shows where spawns are on the map

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Find spawns
local spawns = {}
for _, d in ipairs(workspace:GetDescendants()) do
    if d:IsA("SpawnLocation") then
        table.insert(spawns, d)
    end
end

-- Fallback: parts named "spawn"
if #spawns == 0 then
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and string.lower(d.Name):find("spawn") then
            table.insert(spawns, d)
        end
    end
end

-- Report
print("=== SPAWN CHECK ===")
print("Total spawns found:", #spawns)

if #spawns == 0 then
    print("ERROR: No spawns found on this map")
    print("MM2 may use a different system for player spawning")
    return
end

-- Sort by distance from player
local myPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    and LocalPlayer.Character.HumanoidRootPart.Position or Vector3.zero
table.sort(spawns, function(a, b)
    return (a.Position - myPos).Magnitude < (b.Position - myPos).Magnitude
end)

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "SpawnChecker"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local title = Instance.new("TextLabel")
title.Size = UDim2.new(0, 250, 0, 30)
title.Position = UDim2.new(0.5, -125, 0, 50)
title.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
title.Text = "Found " .. #spawns .. " spawn point(s)"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.Parent = gui

local titleCorner = Instance.new("UICorner")
titleCorner.CornerRadius = UDim.new(0, 6)
titleCorner.Parent = title

-- Number each spawn on the map
for i, spawn in ipairs(spawns) do
    local dist = (spawn.Position - myPos).Magnitude

    local billboard = Instance.new("BillboardGui")
    billboard.Adornee = spawn
    billboard.Size = UDim2.new(0, 130, 0, 44)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = math.huge
    billboard.Parent = gui

    local numLabel = Instance.new("TextLabel")
    numLabel.Size = UDim2.new(1, 0, 0, 24)
    numLabel.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
    numLabel.Text = "#" .. i
    numLabel.TextColor3 = Color3.new(1, 1, 1)
    numLabel.Font = Enum.Font.GothamBold
    numLabel.TextSize = 14
    numLabel.Parent = billboard

    local numCorner = Instance.new("UICorner")
    numCorner.CornerRadius = UDim.new(0, 4)
    numCorner.Parent = numLabel

    local distLabel = Instance.new("TextLabel")
    distLabel.Size = UDim2.new(1, 0, 0, 20)
    distLabel.Position = UDim2.new(0, 0, 0, 24)
    distLabel.BackgroundTransparency = 1
    distLabel.Text = string.format("%.0f studs", dist)
    distLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    distLabel.Font = Enum.Font.Gotham
    distLabel.TextSize = 11
    distLabel.TextStrokeTransparency = 0
    distLabel.Parent = billboard

    -- Console output
    print(string.format("Spawn #%d  |  Position: %.0f, %.0f, %.0f  |  Distance: %.0f",
        i, spawn.Position.X, spawn.Position.Y, spawn.Position.Z, dist))
end

-- Close button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 60, 0, 30)
closeBtn.Position = UDim2.new(0.5, 65, 0, 50)
closeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
closeBtn.Text = "Close"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 12
closeBtn.Parent = gui

local closeCorner = Instance.new("UICorner")
closeCorner.CornerRadius = UDim.new(0, 6)
closeCorner.Parent = closeBtn

closeBtn.MouseButton1Click:Connect(function()
    gui:Destroy()
end)
