        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingToggle = true
            dragStartPos = input.Position
            startBtnPos = toggleBtn.Position
            dragInput = input

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingToggle = false
                    dragInput = nil
                end
            end)
        end
    end

    toggleBtn.InputBegan:Connect(startDraggingToggle)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and draggingToggle then
            local delta = input.Position - dragStartPos
            toggleBtn.Position = UDim2.new(
                startBtnPos.X.Scale,
                startBtnPos.X.Offset + delta.X,
                startBtnPos.Y.Scale,
                startBtnPos.Y.Offset + delta.Y
            )
        end
    end)

    toggleBtn.MouseButton1Click:Connect(function()
        if draggingToggle then return end
        self.Main.Visible = true
        toggleBtn.Visible = false
    end)

    closeBtn.MouseButton1Click:Connect(function()
        self.Main.Visible = false
        toggleBtn.Visible = true
    end)

