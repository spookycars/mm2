            AgentJumpHeight = 8,
            AgentMaxSlope = 50,
            WaypointSpacing = 4
        })
    end)
    if not ok or not path then return nil end
    local computeOk = pcall(function() path:ComputeAsync(fromPos, toPos) end)
    if not computeOk then return nil end
    if path.Status ~= Enum.PathStatus.Success then return nil end
    local wps = path:GetWaypoints()
    if not wps or #wps < 2 then return nil end
    return path, wps
end

local function findClimbableNear(char, centerPos, radius, minY, maxY)
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {char}
    local parts = workspace:GetPartBoundsInRadius(centerPos, radius, overlapParams)
    local best, bestDist = nil, math.huge
    for _, part in ipairs(parts) do
        if not part:IsA("BasePart") then continue end
        local n = string.lower(part.Name)
        local isClimb = n:find("ladder") or n:find("truss") or n:find("climb")
        local isStairs = n:find("stair") or n:find("step") or n:find("ramp")
        if isClimb or isStairs then
            if part.Position.Y >= minY and part.Position.Y <= maxY then
                local d = (part.Position - centerPos).Magnitude
                if d < bestDist then best, bestDist = part, d end
            end
        end
    end
    return best
end

local function shouldRecomputePath(targetPos)
    if not currentPath then return true end
    if #currentWaypoints < 2 then return true end
    if currentWaypointIndex > #currentWaypoints then return true end
    if not lastPathTargetPos then return true end
    local delta = targetPos - lastPathTargetPos
    if delta.Magnitude > PATH_RECOMPUTE_TARGET_DELTA then return true end
    if math.abs(delta.Y) > 6 then return true end
    return false
end

local function startMurdererAutoPlay()
    if autoPlayConnection then return end
    AutoPlayActive = true
    Notify("AutoPlay", "Murderer AutoPlay started", 3)

    autoPlayConnection = RunService.Heartbeat:Connect(function()
        if not AutoPlayActive then return end
        if Murder ~= LocalPlayer.Name then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot or hum.Health <= 0 then return end

        if hum.WalkSpeed < 14 then hum.WalkSpeed = 16 end
        if hum.JumpPower < 50 then hum.JumpPower = 50 end
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

        local myPos = myRoot.Position

        local target = nil
        local nearest = math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if Config.Helper.SelectedPlayer and player == Config.Helper.SelectedPlayer then continue end
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
            if not IsAlive(player) then continue end
            local dist = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < nearest then nearest = dist; target = player end
        end

        if not target then
            return
        end

        local targetPos = target.Character.HumanoidRootPart.Position
        local distanceToTarget = (myPos - targetPos).Magnitude
        local verticalGap = math.abs(myPos.Y - targetPos.Y)

        if distanceToTarget <= ATTACK_DISTANCE then
            local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
            if knife then
                if knife.Parent ~= char then hum:EquipTool(knife) end
                knife:Activate()
            end
            currentPath = nil
            currentWaypoints = {}
            currentWaypointIndex = 1
            lastPathTargetPos = nil
            return
        end

        if Config.Helper.DirectChase then
            hum:MoveTo(targetPos)
            return
        end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local eyePos = myPos + Vector3.new(0, 2.5, 0)
        local targetEyePos = targetPos + Vector3.new(0, 2.5, 0)
        local hit = workspace:Raycast(eyePos, targetEyePos - eyePos, rayParams)
        local targetVisible = (hit == nil)

        local sameLevel = verticalGap < 8
        local canDirectChase = targetVisible and sameLevel and stuckCounter < 2
            and distanceToTarget >= MIN_DIRECT_CHASE_DIST

        if not stuckCheckPos then
            stuckCheckPos = myPos
            stuckCheckTime = tick()
        elseif tick() - stuckCheckTime >= 0.6 then
            if (myPos - stuckCheckPos).Magnitude < 1.5 then
                stuckCounter = stuckCounter + 1
                hum.Jump = true
            else
                stuckCounter = 0
            end
            stuckCheckPos = myPos
            stuckCheckTime = tick()
        end

        if canDirectChase then
            hum:MoveTo(targetPos)
            currentPath = nil
            currentWaypoints = {}
            currentWaypointIndex = 1
            lastPathTargetPos = nil
            return
        end

        local pathGoal = targetPos
        local usedStaging = false
        if verticalGap > 8 then
            local midY = (myPos.Y + targetPos.Y) * 0.5
            local center = Vector3.new(
                (myPos.X + targetPos.X) * 0.5,
                midY,
                (myPos.Z + targetPos.Z) * 0.5
            )
            local climbPart = findClimbableNear(char, center, 40, myPos.Y - 5, targetPos.Y + 5)
            if climbPart then
                pathGoal = Vector3.new(climbPart.Position.X, myPos.Y, climbPart.Position.Z)
                usedStaging = true
            else
                pathGoal = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
                usedStaging = true
            end
        end

        local now = tick()
        local canAttemptPath
        if lastPathFailed and lastFailedTargetPos then
            local moved = (targetPos - lastFailedTargetPos).Magnitude
            canAttemptPath = (now - lastPathAttempt) >= FAILED_RETRY_COOLDOWN or moved > 15
        else
            canAttemptPath = (now - lastPathAttempt) >= PATH_RETRY_COOLDOWN
        end

        if shouldRecomputePath(pathGoal) and canAttemptPath then
            lastPathAttempt = now
            local newPath, wpsOrNil = computePathTo(myPos, pathGoal)
            if newPath then
                currentPath = newPath
                currentWaypoints = wpsOrNil
                currentWaypointIndex = 2
                lastPathTargetPos = pathGoal
                stuckCounter = 0
                lastPathFailed = false
                lastFailedTargetPos = nil
            else
                lastPathFailed = true
                lastFailedTargetPos = targetPos
                if usedStaging then
                    hum:MoveTo(pathGoal)
                else
                    local horizDelta = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
                    if horizDelta.Magnitude < 8 then
                        hum:Move(Vector3.zero)
                    else
                        hum:MoveTo(Vector3.new(targetPos.X, myPos.Y, targetPos.Z))
                    end
                end
                lastPathTargetPos = pathGoal
                return
            end
        end

        if not currentPath or #currentWaypoints < 2 then
            return
        end

        while currentWaypointIndex <= #currentWaypoints do
            local wp = currentWaypoints[currentWaypointIndex]
            local diff = myPos - wp.Position
            local horiz = Vector3.new(diff.X, 0, diff.Z).Magnitude
            local vert = math.abs(diff.Y)

            if wp.Action == Enum.PathWaypointAction.Jump then
                local alreadyJumped = (now - lastJumpTime) < 0.6
                if alreadyJumped and (myPos.Y >= wp.Position.Y - 2 or horiz <= 2) then
                    currentWaypointIndex = currentWaypointIndex + 1
                else
                    break
                end
            else
                local tol = 3
                local vertTol = 5
                if horiz <= tol and vert <= vertTol then
                    currentWaypointIndex = currentWaypointIndex + 1
                else
                    break
                end
            end
        end

        if currentWaypointIndex > #currentWaypoints then
            hum:MoveTo(targetPos)
            return
        end

        local shouldJumpNow = false
        for i = currentWaypointIndex, math.min(currentWaypointIndex + 1, #currentWaypoints) do
            local wp = currentWaypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then
                local horizDist = Vector3.new(
                    wp.Position.X - myPos.X, 0, wp.Position.Z - myPos.Z
                ).Magnitude
                if horizDist <= JUMP_PROXIMITY then
                    shouldJumpNow = true
                end
                break
            end
        end
        if shouldJumpNow and (now - lastJumpTime) > 0.4 then
            hum.Jump = true
            lastJumpTime = now
        end

        local steerIdx = currentWaypointIndex
        for i = currentWaypointIndex + 1, math.min(currentWaypointIndex + LOOKAHEAD_STEPS, #currentWaypoints) do
            local prevWp = currentWaypoints[i - 1]
            local wp = currentWaypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then break end
            if prevWp.Action == Enum.PathWaypointAction.Jump then break end
            if (wp.Position - myPos).Magnitude > MAX_LOOKAHEAD_DIST then break end
            if math.abs(wp.Position.Y - myPos.Y) > 6 then break end
            local wpEye = wp.Position + Vector3.new(0, 2.5, 0)
            if workspace:Raycast(eyePos, wpEye - eyePos, rayParams) then break end
            steerIdx = i
        end

        local nextWp = currentWaypoints[steerIdx]
        local climbGap = nextWp.Position.Y - myPos.Y
        if climbGap > 5 then
            local overlapParams = OverlapParams.new()
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
            overlapParams.FilterDescendantsInstances = {char}
            local parts = workspace:GetPartBoundsInRadius(
                myPos + Vector3.new(0, climbGap * 0.5, 0),
                8, overlapParams
            )
            local foundLadder = false
            for _, part in ipairs(parts) do
                local n = string.lower(part.Name)
                if n:find("ladder") or n:find("truss") or n:find("climb") then
                    foundLadder = true
                    break
                end
            end
            if foundLadder and hum:GetState() ~= Enum.HumanoidStateType.Climbing then
                hum:MoveTo(nextWp.Position)
                hum:ChangeState(Enum.HumanoidStateType.Climbing)
                return
            end
        end

        hum:MoveTo(currentWaypoints[steerIdx].Position)
    end)
end

-- ===================== INNOCENT EVADE AUTO PLAY (DEAD-END AWARE) =====================
local InnocentActive = false
local innocentConnection = nil
local innPath = nil
local innWaypoints = {}
local innWaypointIndex = 1
local innLastRepath = 0
local innTargetSafePos = nil
local innCurrentPathLen = 0
local innLastPos = nil
local innLastProgressCheck = 0
local innBlacklist = {}   -- {pos = Vector3, expires = tick()}
local INN_REPATH_INTERVAL = 0.8
local INN_FLEE_RADIUS = 15
local INN_DANGER_RADIUS = 60
local INN_IDLE_RADIUS = 100
local INN_CANDIDATE_GRID = 20
local INN_MAX_CANDIDATES = 120
local INN_MAX_PATH_DETOUR_RATIO = 3.0
local INN_BLACKLIST_DURATION = 4.0
local INN_PROGRESS_CHECK_INTERVAL = 0.8
local INN_PROGRESS_MIN_DIST = 3.0
local innLastJumpTime = 0

local function stopInnocentAutoPlay()
    InnocentActive = false
    if innocentConnection then innocentConnection:Disconnect(); innocentConnection = nil end
    innPath = nil
    innWaypoints = {}
    innWaypointIndex = 1
    innTargetSafePos = nil
    innLastPos = nil
    innLastProgressCheck = 0
    innBlacklist = {}
end

local function hasLineOfSight(fromPos, toPos, ignoreChar)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {ignoreChar, Camera}
    local result = workspace:Raycast(fromPos, toPos - fromPos, rayParams)
    return result == nil
end

-- Count how many of 8 compass directions are open from a position.
-- Dead ends have 1, corridors have 2, open rooms have 3+.
local function countEscapeRoutes(pos, radius, ignoreChar, murdererChar)
    local dirs = {
        Vector3.new(1,0,0), Vector3.new(-1,0,0),
        Vector3.new(0,0,1), Vector3.new(0,0,-1),
        Vector3.new(0.707,0,0.707), Vector3.new(-0.707,0,0.707),
        Vector3.new(0.707,0,-0.707), Vector3.new(-0.707,0,-0.707),
    }
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {ignoreChar, murdererChar, Camera}
    local count = 0
    local startPos = pos + Vector3.new(0, 2.5, 0)
    for _, dir in ipairs(dirs) do
        local hit = workspace:Raycast(startPos, dir * radius, params)
        if not hit then count = count + 1 end
    end
    return count
end

local function isBlacklisted(pos)
    local now = tick()
    for i = #innBlacklist, 1, -1 do
        local entry = innBlacklist[i]
        if now > entry.expires then
            table.remove(innBlacklist, i)
        elseif (entry.pos - pos).Magnitude < 10 then
            return true
        end
    end
    return false
end

local function blacklistPos(pos)
    table.insert(innBlacklist, {pos = pos, expires = tick() + INN_BLACKLIST_DURATION})
    if #innBlacklist > 8 then table.remove(innBlacklist, 1) end
end

-- Score a candidate position: higher = safer. Now includes escape-route count.
local function scoreCandidate(cand, myPos, murdererPos, myChar, murdererChar)
    if isBlacklisted(cand) then return -math.huge end

    local distFromMurderer = (cand - murdererPos).Magnitude
    local distFromMe = (cand - myPos).Magnitude
    local score = distFromMurderer

    local murdererEye = murdererPos + Vector3.new(0, 2.5, 0)
    local candEye = cand + Vector3.new(0, 2.5, 0)
    local visibleToMurderer = hasLineOfSight(murdererEye, candEye, murdererChar)
    if visibleToMurderer then
        score = score - 30
    end

    score = score - distFromMe * 0.3

    if distFromMe < 25 then
        score = score + 15
    end

    if math.abs(cand.Y - myPos.Y) > 10 then
        score = score - 20
    end

    -- Escape route analysis — the big fix
    local escapeRoutes = countEscapeRoutes(cand, 10, myChar, murdererChar)
    if escapeRoutes <= 1 then
        score = score - 60   -- dead end! strongly avoid
    elseif escapeRoutes == 2 then
        score = score - 10   -- corridor, okay but not great
    elseif escapeRoutes >= 4 then
        score = score + 15   -- open area, good escape potential
    end

    return score
end

local function findSafestCandidate(myPos, murdererPos, myChar, murdererChar)
    local searchRadius = (myPos - murdererPos).Magnitude < INN_DANGER_RADIUS and 40 or 100
    local candidates = {}

    for dx = -searchRadius, searchRadius, INN_CANDIDATE_GRID do
        for dz = -searchRadius, searchRadius, INN_CANDIDATE_GRID do
            if #candidates >= INN_MAX_CANDIDATES then break end
            local cand = Vector3.new(myPos.X + dx, myPos.Y, myPos.Z + dz)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {myChar, murdererChar}
            local groundHit = workspace:Raycast(cand + Vector3.new(0, 5, 0), Vector3.new(0, -50, 0), rayParams)
            if groundHit then
                local groundedCand = Vector3.new(cand.X, groundHit.Position.Y, cand.Z)
                if (groundedCand - murdererPos).Magnitude > INN_FLEE_RADIUS then
                    table.insert(candidates, groundedCand)
                end
            end
        end
    end

    if #candidates == 0 then
        local awayDir = (myPos - murdererPos)
        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
        if awayDir.Magnitude < 0.5 then awayDir = Vector3.new(1, 0, 0) end
        return myPos + awayDir.Unit * 30
    end

    -- Score all candidates and sort descending
    local scored = {}
    for _, cand in ipairs(candidates) do
        local s = scoreCandidate(cand, myPos, murdererPos, myChar, murdererChar)
        if s > -math.huge then
            table.insert(scored, {pos = cand, score = s})
        end
    end
    if #scored == 0 then
        local awayDir = (myPos - murdererPos)
        awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
        if awayDir.Magnitude < 0.5 then awayDir = Vector3.new(1, 0, 0) end
        return myPos + awayDir.Unit * 30
    end
    table.sort(scored, function(a, b) return a.score > b.score end)

    -- Try top candidates in order; validate path length vs straight-line.
    -- If path is >3x straight-line, it's a maze/dead-end trap — reject and try next.
    for i = 1, math.min(5, #scored) do
        local cand = scored[i].pos
        local straightDist = (cand - myPos).Magnitude
        if straightDist < 5 then
            return cand   -- basically already there
        end
        local testPath, testWps = computePathTo(myPos, cand)
        if testPath and testWps then
            local pathLen = 0
            for j = 2, #testWps do
                pathLen = pathLen + (testWps[j].Position - testWps[j-1].Position).Magnitude
            end
            if pathLen <= straightDist * INN_MAX_PATH_DETOUR_RATIO then
                -- This candidate has an efficient path AND decent score. Use it.
                innPath = testPath
                innWaypoints = testWps
                innCurrentPathLen = pathLen
                return cand
            else
                -- Detour too long — likely dead-end routing. Blacklist briefly.
                blacklistPos(cand)
            end
        end
    end

    -- Nothing validated — fall back to top score, walk directly
    innPath = nil
    innWaypoints = {}
    return scored[1].pos
end

local function startInnocentAutoPlay()
    if innocentConnection then return end
    InnocentActive = true
    Notify("Innocent Auto", "Evading murderer (dead-end aware)", 3)

    innocentConnection = RunService.Heartbeat:Connect(function()
        if not InnocentActive then return end
        if Murder == LocalPlayer.Name then return end
        if Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot or hum.Health <= 0 then return end

        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
        if hum.JumpPower < 50 then hum.JumpPower = 50 end
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

        local myPos = myRoot.Position
        local murdererPlayer = Murder and Players:FindFirstChild(Murder)
        if not murdererPlayer or not murdererPlayer.Character then
            return
        end
        local murdererChar = murdererPlayer.Character
        local murdererRoot = murdererChar:FindFirstChild("HumanoidRootPart")
        if not murdererRoot then return end
        local murdererPos = murdererRoot.Position
        local distToMurderer = (myPos - murdererPos).Magnitude

        local murdererEye = murdererPos + Vector3.new(0, 2.5, 0)
        local myEye = myPos + Vector3.new(0, 2.5, 0)
        local murdererCanSeeMe = hasLineOfSight(murdererEye, myEye, murdererChar)

        -- Idle when safe
        if distToMurderer > INN_IDLE_RADIUS and not murdererCanSeeMe then
            hum:Move(Vector3.zero)
            innPath = nil
            innWaypoints = {}
            innWaypointIndex = 1
            return
        end

        local now = tick()

        -- Progress check: if we've been trying to move but haven't, blacklist current target
        if innLastPos and innTargetSafePos then
            if (now - innLastProgressCheck) >= INN_PROGRESS_CHECK_INTERVAL then
                if (myPos - innLastPos).Magnitude < INN_PROGRESS_MIN_DIST then
                    -- Stuck! Blacklist the current safe pos and force a repath
                    blacklistPos(innTargetSafePos)
                    innTargetSafePos = nil
                    innPath = nil
                    innWaypoints = {}
                    innWaypointIndex = 1
                    innLastRepath = 0   -- force immediate repath
                end
                innLastPos = myPos
                innLastProgressCheck = now
            end
        else
            innLastPos = myPos
            innLastProgressCheck = now
        end

        local needRepath = (now - innLastRepath) >= INN_REPATH_INTERVAL
        local inDanger = distToMurderer < INN_DANGER_RADIUS or murdererCanSeeMe

        if needRepath or (inDanger and (not innTargetSafePos or (innTargetSafePos - myPos).Magnitude < 8)) then
            innLastRepath = now
            local safePos = findSafestCandidate(myPos, murdererPos, char, murdererChar)
            if safePos then
                innTargetSafePos = safePos
                if not innPath or #innWaypoints < 2 then
                    hum:MoveTo(safePos)
                    return
                end
                innWaypointIndex = 2
            end
        end

        if not innPath or #innWaypoints < 2 then
            if innTargetSafePos then hum:MoveTo(innTargetSafePos) end
            return
        end

        -- Advance waypoints (jump-aware)
        while innWaypointIndex <= #innWaypoints do
            local wp = innWaypoints[innWaypointIndex]
            local diff = myPos - wp.Position
            local horiz = Vector3.new(diff.X, 0, diff.Z).Magnitude
            local vert = math.abs(diff.Y)
            if wp.Action == Enum.PathWaypointAction.Jump then
                local alreadyJumped = (now - innLastJumpTime) < 0.6
                if alreadyJumped and (myPos.Y >= wp.Position.Y - 2 or horiz <= 2) then
                    innWaypointIndex = innWaypointIndex + 1
                else
                    break
                end
            else
                if horiz <= 3 and vert <= 5 then
                    innWaypointIndex = innWaypointIndex + 1
                else
                    break
                end
            end
        end

        if innWaypointIndex > #innWaypoints then
            -- Reached the target — clear it so we pick a new one
            innTargetSafePos = nil
            innPath = nil
            innWaypoints = {}
            innWaypointIndex = 1
            return
        end

        -- Proactive jump
        for i = innWaypointIndex, math.min(innWaypointIndex + 1, #innWaypoints) do
            local wp = innWaypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then
                local horizDist = Vector3.new(wp.Position.X - myPos.X, 0, wp.Position.Z - myPos.Z).Magnitude
                if horizDist <= 6 and (now - innLastJumpTime) > 0.4 then
                    hum.Jump = true
                    innLastJumpTime = now
                end
                break
            end
        end

        hum:MoveTo(innWaypoints[innWaypointIndex].Position)
    end)
end

-- ===================== HELPER SYSTEM =====================
local lastSpectateState = { sheriff = false, murderer = false }
local lastNotifiedPerk = nil
local lastMurderer = nil

local function updateHelper()
    updateRoles()
    local selectedPlayer = Config.Helper.SelectedPlayer
    if selectedPlayer and not selectedPlayer.Parent then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name == selectedPlayer.Name then
                Config.Helper.SelectedPlayer = p
                selectedPlayer = p
                break
            end
        end
        if not selectedPlayer or not selectedPlayer.Parent then selectedPlayer = nil end
    end

    local selectedIsMurderer = false
    if selectedPlayer then
        local role = getRole(selectedPlayer)
        selectedIsMurderer = (role == "Murderer")
    end
    local localIsMurderer = (Murder == LocalPlayer.Name)
    local localIsSheriff = (Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name)
    local localIsInnocent = not localIsMurderer and not localIsSheriff

    if Config.Helper.AutoPlayer then
        if localIsMurderer then
            startMurdererAutoPlay()
        else
            stopAutoPlay()
        end
    else
        stopAutoPlay()
    end

    if Config.Helper.InnocentAutoPlayer then
        if localIsInnocent then
            startInnocentAutoPlay()
        else
            stopInnocentAutoPlay()
        end
    else
        stopInnocentAutoPlay()
    end

    local wantSpectateSheriff = Config.Helper.SpectateSheriff and not localIsSheriff
    local wantSpectateMurderer = Config.Helper.SpectateMurderer and not localIsMurderer
    local sheriffPlayer = Players:FindFirstChild(Sheriff)
    local murdererPlayer = Players:FindFirstChild(Murder)

    if wantSpectateSheriff and sheriffPlayer and IsAlive(sheriffPlayer) then
        startSpectating(sheriffPlayer)
        lastSpectateState.sheriff = true
        lastSpectateState.murderer = false
    elseif wantSpectateMurderer and murdererPlayer and IsAlive(murdererPlayer) then
        startSpectating(murdererPlayer)
        lastSpectateState.murderer = true
        lastSpectateState.sheriff = false
    else
        if lastSpectateState.sheriff or lastSpectateState.murderer then
            stopSpectating()
            lastSpectateState.sheriff = false
            lastSpectateState.murderer = false
        end
    end

    if Config.Helper.AutoGrabGunNearPlayer and selectedIsMurderer then
        local gundrop = Workspace:FindFirstChild("GunDrop", true)
        if gundrop and gundrop:IsA("BasePart") then
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                if selectedPlayer and player == selectedPlayer then continue end
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    if (player.Character.HumanoidRootPart.Position - gundrop.Position).Magnitude <= 10 then
                        autoGrabGun()
                        break
                    end
                end
            end
        end
    end

    if Config.ESP.NotifyMurdererPerk then
        if Murder and Murder ~= LocalPlayer.Name then
            if Murder ~= lastMurderer then
                lastMurderer = Murder
                lastNotifiedPerk = nil
            end
            local murdererData = roles[Murder]
            if murdererData then
                local perkName = murdererData.Perk or murdererData.MurdererPerk or murdererData.EquippedPerk
                if perkName and perkName ~= lastNotifiedPerk then
                    lastNotifiedPerk = perkName
                    local murdererPlayer = Players:FindFirstChild(Murder)
                    if murdererPlayer then
                        Notify("Murderer Perk", murdererPlayer.Name .. " has " .. perkName, 6)
                    end
                end
            end
        else
            lastMurderer = nil
            lastNotifiedPerk = nil
        end
    end
end

-- ===================== AUTO SHOOT LOOP =====================
RunService.RenderStepped:Connect(function()
    if not Config.Combat.AutoShootMurderer then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local hasGun = hasTool(LocalPlayer, "Gun")
    local hasKnife = hasTool(LocalPlayer, "Knife")
    if not hasGun or hasKnife then return end

    local murderer = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasTool(player, "Knife") then
            murderer = player
            break
        end
    end
    if not murderer or not murderer.Character or not hasTool(murderer, "Knife") then return end

    if not isEquipped(LocalPlayer, "Gun") and not autoEquippedGun then
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
        if gun then
            local hum = myChar:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:EquipTool(gun)
                autoEquippedGun = true
                currentGunObject = gun
            end
        else
            autoGrabGun()
        end
        return
    end

    if isEquipped(LocalPlayer, "Gun") then
        local predictedPos = getPredictedMurdererTargetPos(murderer.Character)
        if predictedPos and tick() - lastShotTime >= SHOOT_COOLDOWN then
            lastShotTime = tick()
            shootAtVector3(predictedPos)
        end
    end
end)

LocalPlayer.Backpack.ChildAdded:Connect(function(child)
    if child.Name == "Gun" and child ~= currentGunObject then
        currentGunObject = child
        autoEquippedGun = false
    end
end)
LocalPlayer.CharacterAdded:Connect(function()
    autoEquippedGun = false
    currentGunObject = nil
end)

-- ===================== SPAWN TELEPORT =====================
RunService.Stepped:Connect(function()
    if not Config.Movement.TeleportSpawn then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    if Murder == LocalPlayer.Name or Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name then return end
    char.HumanoidRootPart.CFrame = CFrame.new(70, 84, 46)
end)

-- ===================== KILL SCRIPT =====================
killScript = function()
    scriptKilled = true
    stopAutoPlay()
    stopInnocentAutoPlay()
    stopFlingLoop()
    stopLoopGoTo()
    stopTrapTrigger()
    destroySpawnBarrier()
    stopSpectating()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    for _, t in ipairs(threads) do
        pcall(function() task.cancel(t) end)
    end
    pcall(function() UI.ScreenGui:Destroy() end)
    if Config.Visuals.FullBright then
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000
        Lighting.GlobalShadows = true
    end
    Notify("Script Killed", "MM2 Script has been unloaded.")
end

