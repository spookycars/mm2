local function cleanMapName(name)
    return string.lower(string.gsub(name, "%s+", ""))
end

local cleanToOriginal = {}
for k, v in pairs(MapHidePositions) do
    cleanToOriginal[cleanMapName(k)] = k
end

local function getCurrentMap()
    for _, child in pairs(Workspace:GetChildren()) do
        if child:IsA("Model") or child:IsA("Folder") then
            local cleanChild = cleanMapName(child.Name)
            local originalKey = cleanToOriginal[cleanChild]
            if originalKey then
                return originalKey
            end
        end
    end
    return nil
end

