function updateESP()
    -- Clear old ESP
    for _, v in pairs(espFolder:GetChildren()) do v:Destroy() end
    for _, v in pairs(chamFolder:GetChildren()) do v:Destroy() end
    for _, v in pairs(gunEspFolder:GetChildren()) do v:Destroy() end

    if not Config.ESP.Enabled then return end
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end

    -- Player ESP
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character or not player.Character:FindFirstChild("Head") then continue end

        local role, color = getRole(player)

        if role == "Murderer" and not Config.ESP.ShowMurderer then continue end
        if role == "Sheriff" and not Config.ESP.ShowSheriff then continue end
        if role == "Innocent" and not Config.ESP.ShowInnocent then continue end

        if not IsAlive(player) then color = Color3.fromRGB(128, 128, 128) end

        if Config.ESP.Chams then
            local cham = Instance.new("Highlight")
            cham.Name = player.Name
            cham.FillTransparency = 1
            cham.OutlineColor = color
            cham.Adornee = player.Character
            cham.Parent = chamFolder
        end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = player.Name
        billboard.Adornee = player.Character.Head
        billboard.Size = UDim2.new(0, 200, 0, 24)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = math.huge
        billboard.Parent = espFolder

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextSize = 14
        label.TextColor3 = color
        label.Text = player.Name
        label.Parent = billboard
    end

    -- Gun ESP (dropped guns)
    if Config.ESP.GunESP then
        for _, desc in pairs(Workspace:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Name == "GunDrop" then
                local billboard = Instance.new("BillboardGui")
                billboard.Adornee = desc
                billboard.Size = UDim2.new(0, 200, 0, 24)
                billboard.StudsOffset = Vector3.new(0, 2, 0)
