    page.ClipsDescendants = false
    page.Parent = self.Content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.Parent = page

    local tab = {
        Button = tabBtn,
        Page = page,
        Name = name
    }

    table.insert(self.Tabs, tab)

    tabBtn.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    if #self.Tabs == 1 then
        self:SelectTab(tab)
    end

    return page
