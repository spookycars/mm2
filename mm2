local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

local raycastParams = RaycastParams.new()
raycastParams.FilterDescendantsInstances = {character}
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function getAvoidanceDirection()
	-- Cast a ray forward 5 studs
	local rayOrigin = rootPart.Position
	local rayDirection = rootPart.CFrame.LookVector * 5
	local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)

	if rayResult then
		-- Hit a wall: turn right or left
		return rootPart.CFrame.RightVector * (math.random() > 0.5 and 1 or -1)
	else
		-- Clear path: keep walking forward
		return rootPart.CFrame.LookVector
	end
end

RunService.Heartbeat:Connect(function()
	if humanoid and rootPart then
		local moveDir = getAvoidanceDirection()
		humanoid:Move(moveDir, true)
	end
end)
