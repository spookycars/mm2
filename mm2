local candyWpIndex = 1
local candyLastJumpTime = 0
local candyLastPathAttempt = 0
local candyPathFailed = false
local candyLastFailedTargetPos = nil
local candyLastPathTargetPos = nil
local candyStuckPos = nil
local candyStuckTime = 0
local candyStuckCounter = 0
local candyCurrentTargetPart = nil
local candyBadTarget = nil
local candyBadTargetTime = 0

local CANDY_PATH_RETRY_COOLDOWN = 0.5
local CANDY_FAILED_RETRY_COOLDOWN = 2.0
local CANDY_MIN_DIRECT_DIST = 4
local CANDY_BAD_COOLDOWN = 5.0
local CANDY_REACH_DIST = 6
local CANDY_MURDERER_EXCLUDE = 30
local CANDY_MURDERER_ABANDON = 40

local function resetCandyState()
    candyPath = nil
    candyWaypoints = {}
    candyWpIndex = 1
    candyLastPathTargetPos = nil
    candyLastPathAttempt = 0
    candyPathFailed = false
    candyLastFailedTargetPos = nil
    candyStuckPos = nil
    candyStuckCounter = 0
    candyCurrentTargetPart = nil
end

local function stopCandyFarm()
    CandyActive = false
    if candyConnection then candyConnection:Disconnect(); candyConnection = nil end
    resetCandyState()
    candyBadTarget = nil
    candyBadTargetTime = 0
end

local function isCandyPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local n = string.lower(part.Name)
    if n:find("candy") or n:find("coin") or n:find("collect") or n:find("money") then
        return true
    end
    local ok, tags = pcall(function() return CollectionService:GetTags(part) end)
    if ok and tags then
        for _, tag in ipairs(tags) do
            local t = string.lower(tag)
            if t:find("candy") or t:find("coin") or t:find("collect") then
                return true
            end
        end
    end
    local parent = part.Parent
    if parent then
        local pn = string.lower(parent.Name)
        if pn:find("candy") or pn:find("coin") or pn:find("collect") or pn:find("drop") then
            return true
        end
    end
    return false
end

local function findBestCandy(myPos, murdererPos, now)
    local best, bestScore = nil, -math.huge
    for _, d in ipairs(workspace:GetDescendants()) do
        if isCandyPart(d) then
            if d == candyBadTarget and (now - candyBadTargetTime) < CANDY_BAD_COOLDOWN then
                continue
            end
            local pos = d.Position
            local distFromMe = (pos - myPos).Magnitude
            local distFromMurderer = 999
            if murdererPos then
                distFromMurderer = (pos - murdererPos).Magnitude
                if distFromMurderer < CANDY_MURDERER_EXCLUDE then
                    continue
                end
            end
            local score = distFromMurderer - 0.3 * distFromMe
            if score > bestScore then
                bestScore = score
                best = d
            end
        end
    end
    return best
end

local function startCandyFarm()
    if candyConnection then return end
    CandyActive = true
    resetCandyState()
    Notify("Candy Farm", "Chasing safe candies (avoiding murderer)", 3)

    candyConnection = RunService.Heartbeat:Connect(function()
        if not CandyActive then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot then return end
        if not canRunAutoplay(char, hum) then
            pcall(function() hum:Move(Vector3.zero) end)
            return
        end

        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
        if hum.JumpPower < 50 then hum.JumpPower = 50 end
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

        local myPos = myRoot.Position
        local now = tick()

        local murdererPos = nil
        local murdererPlayer = Murder and Players:FindFirstChild(Murder)
        if murdererPlayer and murdererPlayer.Character then
            local mRoot = murdererPlayer.Character:FindFirstChild("HumanoidRootPart")
            if mRoot then murdererPos = mRoot.Position end
        end

        if candyCurrentTargetPart and candyCurrentTargetPart.Parent and murdererPos then
            local candyToMurderer = (candyCurrentTargetPart.Position - murdererPos).Magnitude
            if candyToMurderer < CANDY_MURDERER_ABANDON then
                candyBadTarget = candyCurrentTargetPart
                candyBadTargetTime = now
                candyCurrentTargetPart = nil
                resetCandyState()
            end
        end

        local target = candyCurrentTargetPart
        if not target or not target.Parent then
            local found = findBestCandy(myPos, murdererPos, now)
            if not found then
                if hum.MoveDirection.Magnitude > 0 then
                    hum:Move(Vector3.zero)
                end
                return
            end
            target = found
            candyCurrentTargetPart = target
            resetCandyState()
            candyCurrentTargetPart = target
        end

        local targetPos = target.Position
        local distToTarget = (myPos - targetPos).Magnitude
        if distToTarget < CANDY_REACH_DIST then
            hum:Move(Vector3.zero)
            return
        end

        if not candyStuckPos then
            candyStuckPos = myPos
            candyStuckTime = now
        elseif (now - candyStuckTime) >= 0.6 then
            if (myPos - candyStuckPos).Magnitude < 1.5 then
                candyStuckCounter = candyStuckCounter + 1
                if (now - candyLastJumpTime) > 0.6 then
                    hum.Jump = true
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    candyLastJumpTime = now
                end
                if candyStuckCounter >= 3 then
                    candyBadTarget = target
                    candyBadTargetTime = now
                    candyStuckCounter = 0
                    resetCandyState()
                    return
                end
            else
                candyStuckCounter = 0
            end
            candyStuckPos = myPos
            candyStuckTime = now
        end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local eyePos = myPos + Vector3.new(0, 2.5, 0)
        local targEye = targetPos + Vector3.new(0, 2.5, 0)
        local hit = workspace:Raycast(eyePos, targEye - eyePos, rayParams)
        local visible = (hit == nil)
        local sameLevel = math.abs(myPos.Y - targetPos.Y) < 4
        local canDirect = visible and sameLevel and distToTarget >= CANDY_MIN_DIRECT_DIST

        if canDirect then
            if shouldJumpOverObstacle(char, hum, myRoot, targetPos) then
                if (now - candyLastJumpTime) > 0.5 then
                    hum.Jump = true
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    candyLastJumpTime = now
                    return
                end
            end
            hum:MoveTo(targetPos)
            candyPath = nil
            candyWaypoints = {}
            candyWpIndex = 1
            candyLastPathTargetPos = nil
            return
        end

        local needRepath = (not candyPath)
            or (#candyWaypoints < 2)
            or (candyWpIndex > #candyWaypoints)
            or (not candyLastPathTargetPos)
            or ((targetPos - candyLastPathTargetPos).Magnitude > 10)
            or (math.abs((targetPos - candyLastPathTargetPos).Y) > 6)

        local canAttempt
        if candyPathFailed and candyLastFailedTargetPos then
            local moved = (targetPos - candyLastFailedTargetPos).Magnitude
            canAttempt = (now - candyLastPathAttempt) >= CANDY_FAILED_RETRY_COOLDOWN or moved > 15
        else
            canAttempt = (now - candyLastPathAttempt) >= CANDY_PATH_RETRY_COOLDOWN
        end

        if needRepath and canAttempt then
            candyLastPathAttempt = now
            local p, w = computePathTo(myPos, targetPos)
            if not p then
                if canReachDirectly(myPos, targetPos, char) then
                    p = makeSyntheticDirectPath(myPos, targetPos)
                    w = p:GetWaypoints()
                end
            end
            if p then
                candyPath = p
                candyWaypoints = w
                candyWpIndex = 2
                candyLastPathTargetPos = targetPos
                candyPathFailed = false
                candyLastFailedTargetPos = nil
            else
                candyPathFailed = true
                candyLastFailedTargetPos = targetPos
                if canReachDirectly(myPos, targetPos, char) then
                    hum:MoveTo(targetPos)
                else
                    hum:Move(Vector3.zero)
                end
                return
            end
        end

        if not candyPath or #candyWaypoints < 2 then return end

        while candyWpIndex <= #candyWaypoints do
            local wp = candyWaypoints[candyWpIndex]
            local diff = myPos - wp.Position
            local horiz = Vector3.new(diff.X, 0, diff.Z).Magnitude
            local vert = math.abs(diff.Y)
            if wp.Action == Enum.PathWaypointAction.Jump then
                local alreadyJumped = (now - candyLastJumpTime) < 0.6
                if alreadyJumped and (myPos.Y >= wp.Position.Y - 2 or horiz <= 2) then
                    candyWpIndex = candyWpIndex + 1
                else
                    break
                end
            else
                if horiz <= 3 and vert <= 5 then
                    candyWpIndex = candyWpIndex + 1
                else
                    break
                end
            end
        end

        if candyWpIndex > #candyWaypoints then
            if canReachDirectly(myPos, targetPos, char) then hum:MoveTo(targetPos) end
            candyPath = nil
            candyWaypoints = {}
            candyWpIndex = 1
            return
        end

        for i = candyWpIndex, math.min(candyWpIndex + 1, #candyWaypoints) do
            local wp = candyWaypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then
                local horizDist = Vector3.new(
                    wp.Position.X - myPos.X, 0, wp.Position.Z - myPos.Z
                ).Magnitude
                if horizDist <= 6 and (now - candyLastJumpTime) > 0.4 then
                    hum.Jump = true
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                    candyLastJumpTime = now
                    return
                end
                break
            end
        end

        local steerIdx = candyWpIndex
        for i = candyWpIndex + 1, math.min(candyWpIndex + 5, #candyWaypoints) do
            local prevWp = candyWaypoints[i - 1]
            local wp = candyWaypoints[i]
            if wp.Action == Enum.PathWaypointAction.Jump then break end
            if prevWp.Action == Enum.PathWaypointAction.Jump then break end
            if (wp.Position - myPos).Magnitude > 40 then break end
            if math.abs(wp.Position.Y - myPos.Y) > 6 then break end
            local wpEye = wp.Position + Vector3.new(0, 2.5, 0)
            if workspace:Raycast(eyePos, wpEye - eyePos, rayParams) then break end
            steerIdx = i
        end

        local nextWp = candyWaypoints[steerIdx]
        local climbGap = nextWp.Position.Y - myPos.Y
        if climbGap > 5 then
            local overlapParams = OverlapParams.new()
            overlapParams.FilterType = Enum.RaycastFilterType.Exclude
            overlapParams.FilterDescendantsInstances = {char}
            local parts = workspace:GetPartBoundsInRadius(
                myPos + Vector3.new(0, climbGap * 0.5, 0),
                8, overlapParams
            )
            local foundLadder = false
            for _, part in ipairs(parts) do
                local n = string.lower(part.Name)
                if n:find("ladder") or n:find("truss") or n:find("climb") then
                    foundLadder = true
                    break
                end
            end
            if foundLadder and hum:GetState() ~= Enum.HumanoidStateType.Climbing then
                hum:MoveTo(nextWp.Position)
                hum:ChangeState(Enum.HumanoidStateType.Climbing)
                return
            end
        end

        if shouldJumpOverObstacle(char, hum, myRoot, nextWp.Position) then
            if (now - candyLastJumpTime) > 0.5 then
                hum.Jump = true
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
                candyLastJumpTime = now
                return
            end
        end

        hum:MoveTo(candyWaypoints[steerIdx].Position)
    end)
end

local lastSpectateState = { sheriff = false, murderer = false }
local lastNotifiedPerk = nil
local lastMurderer = nil

local function updateHelper()
    updateRoles()
    local selectedPlayer = Config.Helper.SelectedPlayer
    if selectedPlayer and not selectedPlayer.Parent then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name == selectedPlayer.Name then
                Config.Helper.SelectedPlayer = p
                selectedPlayer = p
                break
            end
        end
        if not selectedPlayer or not selectedPlayer.Parent then selectedPlayer = nil end
    end

    local selectedIsMurderer = false
    if selectedPlayer then
        local role = getRole(selectedPlayer)
        selectedIsMurderer = (role == "Murderer")
    end
    local localIsMurderer = (Murder == LocalPlayer.Name)
    local localIsSheriff = (Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name)
    local localIsInnocent = not localIsMurderer and not localIsSheriff

    if Config.Helper.AutoPlayer then
        if localIsMurderer then startMurdererAutoPlay() else stopAutoPlay() end
    else
        stopAutoPlay()
    end

    if Config.Helper.InnocentAutoPlayer then
        if localIsInnocent then startCandyFarm() else stopCandyFarm() end
    else
        stopCandyFarm()
    end

    local wantSpectateSheriff = Config.Helper.SpectateSheriff and not localIsSheriff
    local wantSpectateMurderer = Config.Helper.SpectateMurderer and not localIsMurderer
    local sheriffPlayer = Players:FindFirstChild(Sheriff)
    local murdererPlayer = Players:FindFirstChild(Murder)

    if wantSpectateSheriff and sheriffPlayer and IsAlive(sheriffPlayer) then
        startSpectating(sheriffPlayer)
        lastSpectateState.sheriff = true
        lastSpectateState.murderer = false
    elseif wantSpectateMurderer and murdererPlayer and IsAlive(murdererPlayer) then
        startSpectating(murdererPlayer)
        lastSpectateState.murderer = true
        lastSpectateState.sheriff = false
    else
        if lastSpectateState.sheriff or lastSpectateState.murderer then
            stopSpectating()
            lastSpectateState.sheriff = false
            lastSpectateState.murderer = false
        end
    end

    if Config.Helper.AutoGrabGunNearPlayer and selectedIsMurderer then
        local gundrop = Workspace:FindFirstChild("GunDrop", true)
        if gundrop and gundrop:IsA("BasePart") then
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                if selectedPlayer and player == selectedPlayer then continue end
                if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    if (player.Character.HumanoidRootPart.Position - gundrop.Position).Magnitude <= 10 then
                        autoGrabGun()
                        break
                    end
                end
            end
        end
    end

    if Config.ESP.NotifyMurdererPerk then
        if Murder and Murder ~= LocalPlayer.Name then
            if Murder ~= lastMurderer then
                lastMurderer = Murder
                lastNotifiedPerk = nil
            end
            local murdererData = roles[Murder]
            if murdererData then
                local perkName = murdererData.Perk or murdererData.MurdererPerk or murdererData.EquippedPerk
                if perkName and perkName ~= lastNotifiedPerk then
                    lastNotifiedPerk = perkName
                    local murdererPlayer2 = Players:FindFirstChild(Murder)
                    if murdererPlayer2 then
                        Notify("Murderer Perk", murdererPlayer2.Name .. " has " .. perkName, 6)
                    end
                end
            end
        else
            lastMurderer = nil
            lastNotifiedPerk = nil
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not Config.Combat.AutoShootMurderer then return end
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local hum = myChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if not canRunAutoplay(myChar, hum) then return end
    local hasGun = hasTool(LocalPlayer, "Gun")
    local hasKnife = hasTool(LocalPlayer, "Knife")
    if not hasGun or hasKnife then return end
    local murderer = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and hasTool(player, "Knife") then murderer = player; break end
    end
    if not murderer or not murderer.Character or not hasTool(murderer, "Knife") then return end
    if not isEquipped(LocalPlayer, "Gun") and not autoEquippedGun then
        local gun = LocalPlayer.Backpack:FindFirstChild("Gun")
        if gun then
            hum:EquipTool(gun); autoEquippedGun = true; currentGunObject = gun
        else autoGrabGun() end
        return
    end
    if isEquipped(LocalPlayer, "Gun") then
        local predictedPos = getPredictedMurdererTargetPos(murderer.Character)
        if predictedPos and tick() - lastShotTime >= SHOOT_COOLDOWN then
            lastShotTime = tick()
            shootAtVector3(predictedPos)
        end
    end
end)

LocalPlayer.Backpack.ChildAdded:Connect(function(child)
    if child.Name == "Gun" and child ~= currentGunObject then
        currentGunObject = child
        autoEquippedGun = false
    end
end)
LocalPlayer.CharacterAdded:Connect(function()
    autoEquippedGun = false
    currentGunObject = nil
end)

RunService.Stepped:Connect(function()
    if not Config.Movement.TeleportSpawn then return end
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not canRunAutoplay(char, hum) then return end
    if Murder == LocalPlayer.Name or Sheriff == LocalPlayer.Name or Hero == LocalPlayer.Name then return end
    char.HumanoidRootPart.CFrame = CFrame.new(70, 84, 46)
end)

killScript = function()
    scriptKilled = true
    stopAutoPlay()
    stopCandyFarm()
    stopFlingLoop()
    stopLoopGoTo()
    stopTrapTrigger()
    destroySpawnBarrier()
    stopSpectating()
    for _, conn in ipairs(connections) do pcall(function() conn:Disconnect() end) end
    for _, t in ipairs(threads) do pcall(function() task.cancel(t) end) end
    pcall(function() UI.ScreenGui:Destroy() end)
    if Config.Visuals.FullBright then
        Lighting.Brightness = 1; Lighting.ClockTime = 14; Lighting.FogEnd = 1000
        Lighting.GlobalShadows = true
    end
    Notify("Script Killed", "MM2 Script has been unloaded.")
end

addThread(task.spawn(function()
    while not scriptKilled do task.wait(1); pcall(updateRoles) end
end))
addThread(task.spawn(function()
    while not scriptKilled do task.wait(0.3); pcall(updateESP) end
end))
addThread(task.spawn(function()
    while not scriptKilled do task.wait(0.5); pcall(updateHelper) end
end))
addThread(task.spawn(function()
    while not scriptKilled do
        task.wait(0.1)
        if Config.Combat.AutoGrabGun then pcall(autoGrabGun) end
    end
end))
addConnection(RunService.Stepped:Connect(function()
    if scriptKilled then return end
    if Config.Movement.Noclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end))
addConnection(Players.PlayerAdded:Connect(function(player)
    if savedData.SelectedPlayer and player.Name == savedData.SelectedPlayer then
        Config.Helper.SelectedPlayer = player
    end
end))
addThread(task.spawn(function()
    while not scriptKilled do task.wait(5); pcall(SaveSettings) end
end))

