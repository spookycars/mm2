-- ===================== NAV HELPERS =====================
local function isDirectLineClear(fromPos, toPos, ignoreChar)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {ignoreChar, Camera}
    local dir = toPos - fromPos
    if dir.Magnitude < 0.1 then return true, toPos end
    local result = workspace:Raycast(fromPos, dir, rayParams)
    if not result then return true, toPos end
    local currentStart = fromPos
    local safety = 0
    while result and result.Instance and result.Instance.CanCollide == false and safety < 10 do
        safety = safety + 1
        table.insert(rayParams.FilterDescendantsInstances, result.Instance)
        currentStart = result.Position + dir.Unit * 0.1
        result = workspace:Raycast(currentStart, toPos - currentStart, rayParams)
    end
    if not result then return true, toPos end
    return false, result.Position
end

local function canReachDirectly(fromPos, toPos, ignoreChar)
    local isClear, _ = isDirectLineClear(
        fromPos + Vector3.new(0, 2.5, 0),
        toPos + Vector3.new(0, 2.5, 0),
        ignoreChar
    )
    return isClear
end

local function computePathTo(fromPos, toPos)
    local ok, path = pcall(function()
        return PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
            AgentCanClimb = true,
            AgentJumpHeight = 8,
            AgentMaxSlope = 50,
            WaypointSpacing = 4
        })
    end)
    if not ok or not path then return nil end
    local computeOk = pcall(function() path:ComputeAsync(fromPos, toPos) end)
    if not computeOk then return nil end
    if path.Status ~= Enum.PathStatus.Success then return nil end
    local wps = path:GetWaypoints()
    if not wps or #wps < 2 then return nil end
    return path, wps
end

local function makeSyntheticDirectPath(fromPos, toPos)
    return {
        Status = Enum.PathStatus.Success,
        GetWaypoints = function()
            return {
                { Position = fromPos, Action = Enum.PathWaypointAction.Walk },
                { Position = toPos,   Action = Enum.PathWaypointAction.Walk },
            }
        end
    }
end

local pathState = {
    currentPath = nil,
    currentWaypoints = {},
    currentWaypointIndex = 1,
    lastJumpTime = 0,
    lastHorizVel = 0,
}

local function resetPathState()
    pathState.currentPath = nil
    pathState.currentWaypoints = {}
    pathState.currentWaypointIndex = 1
    pathState.lastHorizVel = 0
end

local function shouldJumpOverObstacle(char, hum, myRoot, moveTarget)
    if not moveTarget then return false end
    local myPos = myRoot.Position
    local toTarget = moveTarget - myPos
    toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    if toTarget.Magnitude < 0.5 then return false end
    local dir = toTarget.Unit
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {char, Camera}
    local headStart = myPos + Vector3.new(0, 5, 0)
    local headHit = workspace:Raycast(headStart, Vector3.new(0, 8, 0), rayParams)
    if headHit then return false end
    local chestStart = myPos + Vector3.new(0, 2.5, 0)
    local hit = workspace:Raycast(chestStart, dir * 2.5, rayParams)
    if not hit or not hit.Instance then return false end
    if hit.Instance.CanCollide == false then return false end
    local topProbeStart = hit.Position + Vector3.new(0, 8, 0)
    local topHit = workspace:Raycast(topProbeStart, Vector3.new(0, -12, 0), rayParams)
    if not topHit then return false end
    local obstacleHeight = topHit.Position.Y - myPos.Y
    if obstacleHeight > 3 then return false end
    local beyondStart = hit.Position + dir * 2 + Vector3.new(0, 3, 0)
    local floorBeyond = workspace:Raycast(beyondStart, Vector3.new(0, -8, 0), rayParams)
    if not floorBeyond then return false end
    return true
end

local function findClimbableNear(char, centerPos, radius, minY, maxY)
    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {char}
    local parts = workspace:GetPartBoundsInRadius(centerPos, radius, overlapParams)
    local best, bestDist = nil, math.huge
    for _, part in ipairs(parts) do
        if not part:IsA("BasePart") then continue end
        local n = string.lower(part.Name)
        local isClimb = n:find("ladder") or n:find("truss") or n:find("climb")
        local isStairs = n:find("stair") or n:find("step") or n:find("ramp")
        if isClimb or isStairs then
            if part.Position.Y >= minY and part.Position.Y <= maxY then
                local d = (part.Position - centerPos).Magnitude
                if d < bestDist then best, bestDist = part, d end
            end
        end
    end
    return best
end

local function executeWaypointPath(char, hum, myRoot, waypoints, waypointIndex, now)
    local myPos = myRoot.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {char}
    local eyePos = myPos + Vector3.new(0, 2.5, 0)

    while waypointIndex <= #waypoints do
        local wp = waypoints[waypointIndex]
        local diff = myPos - wp.Position
        local horiz = Vector3.new(diff.X, 0, diff.Z).Magnitude
        local vert = math.abs(diff.Y)
        if wp.Action == Enum.PathWaypointAction.Jump then
            local alreadyJumped = (now - pathState.lastJumpTime) < 0.6
            if alreadyJumped and (myPos.Y >= wp.Position.Y - 2 or horiz <= 2) then
                waypointIndex = waypointIndex + 1
            else
                break
            end
        else
            if horiz <= 3 and vert <= 5 then
                waypointIndex = waypointIndex + 1
            else
                break
            end
        end
    end

    if waypointIndex > #waypoints then return "arrived", waypointIndex end

    for i = waypointIndex, math.min(waypointIndex + 1, #waypoints) do
        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then
            local horizDist = Vector3.new(wp.Position.X - myPos.X, 0, wp.Position.Z - myPos.Z).Magnitude
            if horizDist <= 6 then
                local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
                if jumped then
                    pathState.lastJumpTime = newTime
                    return "walking", waypointIndex
                end
            end
            break
        end
    end

    local steerIdx = waypointIndex
    for i = waypointIndex + 1, math.min(waypointIndex + 5, #waypoints) do
        local prevWp = waypoints[i - 1]
        local wp = waypoints[i]
        if wp.Action == Enum.PathWaypointAction.Jump then break end
        if prevWp.Action == Enum.PathWaypointAction.Jump then break end
        if (wp.Position - myPos).Magnitude > 40 then break end
        if math.abs(wp.Position.Y - myPos.Y) > 6 then break end
        local wpEye = wp.Position + Vector3.new(0, 2.5, 0)
        if workspace:Raycast(eyePos, wpEye - eyePos, rayParams) then break end
        steerIdx = i
    end

    local nextWp = waypoints[steerIdx]
    local climbGap = nextWp.Position.Y - myPos.Y
    if climbGap > 5 then
        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        overlapParams.FilterDescendantsInstances = {char}
        local parts = workspace:GetPartBoundsInRadius(
            myPos + Vector3.new(0, climbGap * 0.5, 0),
            8, overlapParams
        )
        local foundLadder = false
        for _, part in ipairs(parts) do
            local n = string.lower(part.Name)
            if n:find("ladder") or n:find("truss") or n:find("climb") then
                foundLadder = true
                break
            end
        end
        if foundLadder and hum:GetState() ~= Enum.HumanoidStateType.Climbing then
            hum:MoveTo(nextWp.Position)
            hum:ChangeState(Enum.HumanoidStateType.Climbing)
            return "walking", waypointIndex
        end
    end

    if shouldJumpOverObstacle(char, hum, myRoot, nextWp.Position) then
        local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
        if jumped then
            pathState.lastJumpTime = newTime
            return "walking", waypointIndex
        end
    end

    local horizVel = Vector3.new(
        myRoot.AssemblyLinearVelocity.X, 0, myRoot.AssemblyLinearVelocity.Z
    ).Magnitude
    if pathState.lastHorizVel > 4 and horizVel < 1 then
        if shouldJumpOverObstacle(char, hum, myRoot, nextWp.Position) then
            local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
            if jumped then
                pathState.lastJumpTime = newTime
                pathState.lastHorizVel = horizVel
                return "walking", waypointIndex
            end
        end
    end
    pathState.lastHorizVel = horizVel

    hum:MoveTo(waypoints[steerIdx].Position)
    return "walking", waypointIndex
end

local lastSpawnTime = 0
local SPAWN_SETTLE = 1.0

LocalPlayer.CharacterAdded:Connect(function()
    lastSpawnTime = tick()
    pathState.lastJumpTime = 0
    pathState.lastHorizVel = 0
    pathState.currentPath = nil
    pathState.currentWaypoints = {}
    pathState.currentWaypointIndex = 1
end)

local function canRunAutoplay(char, hum)
    if not char or not hum then return false end
    if hum.Health <= 0 then return false end
    if (tick() - lastSpawnTime) < SPAWN_SETTLE then return false end
    local state = hum:GetState()
    if state == Enum.HumanoidStateType.Dead
        or state == Enum.HumanoidStateType.Physics
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Ragdoll then
        return false
    end
    return true
end

-- ===================== MURDERER AUTOPLAY =====================
local murdererAutoPlayActive = false
local murdererAutoPlayStop = nil

local function stopMurdererAutoPlay()
    murdererAutoPlayActive = false
    if murdererAutoPlayStop then murdererAutoPlayStop(); murdererAutoPlayStop = nil end
end

local function startMurdererAutoPlay()
    if murdererAutoPlayActive then return end
    murdererAutoPlayActive = true
    Notify("AutoPlay", "Murderer AutoPlay started", 3)

    local connection = nil
    local active = true
    local PATH_RETRY_COOLDOWN = 0.5
    local FAILED_RETRY_COOLDOWN = 2.0
    local ATTACK_DISTANCE = 2
    local STAB_SWING_RANGE = 3
    local CLOSE_GAP_RANGE = 6
    local PATH_RECOMPUTE_TARGET_DELTA = 10
    local MIN_DIRECT_CHASE_DIST = 6
    local stuckCheckPos = nil
    local stuckCheckTime = 0
    local stuckCounter = 0
    local lastPathTargetPos = nil
    local lastPathAttempt = 0
    local lastPathFailed = false
    local lastFailedTargetPos = nil
    local lastUnreachableTarget = nil
    local lastUnreachableTime = 0
    local UNREACHABLE_COOLDOWN = 5.0

    local function shouldRecomputePath(targetPos)
        if not pathState.currentPath then return true end
        if #pathState.currentWaypoints < 2 then return true end
        if pathState.currentWaypointIndex > #pathState.currentWaypoints then return true end
        if not lastPathTargetPos then return true end
        local delta = targetPos - lastPathTargetPos
        if delta.Magnitude > PATH_RECOMPUTE_TARGET_DELTA then return true end
        if math.abs(delta.Y) > 6 then return true end
        return false
    end

    connection = RunService.Heartbeat:Connect(function()
        if not active then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot then return end
        if not canRunAutoplay(char, hum) then
            pcall(function() hum:Move(Vector3.zero) end)
            return
        end

        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
        if hum.JumpPower < 50 then hum.JumpPower = 50 end
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

        local myPos = myRoot.Position
        local now = tick()

        local target = nil
        local nearest = math.huge
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if Config.Helper.SelectedPlayer and player == Config.Helper.SelectedPlayer then continue end
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then continue end
            if not IsAlive(player) then continue end
            if player.Name == lastUnreachableTarget and (now - lastUnreachableTime) < UNREACHABLE_COOLDOWN then continue end
            local dist = (myPos - player.Character.HumanoidRootPart.Position).Magnitude
            if dist < nearest then nearest = dist; target = player end
        end

        if not target then return end

        local targetPos = target.Character.HumanoidRootPart.Position
        local distanceToTarget = (myPos - targetPos).Magnitude
        local verticalGap = math.abs(myPos.Y - targetPos.Y)

        -- Mirror target jump
        if Config.Helper.MirrorJump and target.Character then
            local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
            if targetHum and canJump(hum) and distanceToTarget < 20 and verticalGap < 6 then
                if targetHum.Jump == true
                    or targetHum:GetState() == Enum.HumanoidStateType.Jumping
                    or targetHum:GetState() == Enum.HumanoidStateType.Freefall then
                    local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
                    if jumped then pathState.lastJumpTime = newTime end
                end
            end
        end

        -- Close-gap step-in
        if distanceToTarget <= CLOSE_GAP_RANGE then
            if canReachDirectly(myPos, targetPos, char) then
                hum:MoveTo(targetPos)
                if distanceToTarget <= STAB_SWING_RANGE then
                    local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
                    if knife then
                        if knife.Parent ~= char then hum:EquipTool(knife) end
                        knife:Activate()
                    end
                end
                return
            end
        end

        if distanceToTarget <= ATTACK_DISTANCE then
            local knife = LocalPlayer.Backpack:FindFirstChild("Knife") or char:FindFirstChild("Knife")
            if knife then
                if knife.Parent ~= char then hum:EquipTool(knife) end
                knife:Activate()
            end
            resetPathState()
            lastPathTargetPos = nil
            return
        end

        if Config.Helper.DirectChase then
            if canReachDirectly(myPos, targetPos, char) then
                if shouldJumpOverObstacle(char, hum, myRoot, targetPos) then
                    local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
                    if jumped then pathState.lastJumpTime = newTime; return end
                end
                hum:MoveTo(targetPos)
                return
            end
        end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {char}
        local eyePos = myPos + Vector3.new(0, 2.5, 0)
        local targetEyePos = targetPos + Vector3.new(0, 2.5, 0)
        local hit = workspace:Raycast(eyePos, targetEyePos - eyePos, rayParams)
        local targetVisible = (hit == nil)
        local sameLevel = verticalGap < 4
        local canDirectChase = targetVisible and sameLevel and stuckCounter < 2
            and distanceToTarget >= MIN_DIRECT_CHASE_DIST

        if not stuckCheckPos then
            stuckCheckPos = myPos
            stuckCheckTime = tick()
        elseif tick() - stuckCheckTime >= 0.6 then
            if (myPos - stuckCheckPos).Magnitude < 1.5 then
                stuckCounter = stuckCounter + 1
                if shouldJumpOverObstacle(char, hum, myRoot, targetPos) then
                    local jumped, newTime = tryJump(hum, now, pathState.lastJumpTime)
                    if jumped then pathState.lastJumpTime = newTime end
                end
                if stuckCounter >= 3 then
                    lastUnreachableTarget = target.Name
                    lastUnreachableTime = now
                    stuckCounter = 0
                    resetPathState()
                    lastPathTargetPos = nil
                    return
                end
            else
                stuckCounter = 0
            end
            stuckCheckPos = myPos
            stuckCheckTime = tick()
        end

        if canDirectChase then
            hum:MoveTo(targetPos)
            resetPathState()
            lastPathTargetPos = nil
            return
        end

        local pathGoal = targetPos
        local usedStaging = false
        if verticalGap > 8 then
            local midY = (myPos.Y + targetPos.Y) * 0.5
            local center = Vector3.new(
                (myPos.X + targetPos.X) * 0.5, midY, (myPos.Z + targetPos.Z) * 0.5
            )
            local climbPart = findClimbableNear(char, center, 40, myPos.Y - 5, targetPos.Y + 5)
            if climbPart then
                pathGoal = Vector3.new(climbPart.Position.X, myPos.Y, climbPart.Position.Z)
                usedStaging = true
            else
                pathGoal = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
                usedStaging = true
            end
        end

        local canAttemptPath
        if lastPathFailed and lastFailedTargetPos then
            local moved = (targetPos - lastFailedTargetPos).Magnitude
            canAttemptPath = (now - lastPathAttempt) >= FAILED_RETRY_COOLDOWN or moved > 15
        else
            canAttemptPath = (now - lastPathAttempt) >= PATH_RETRY_COOLDOWN
        end

        if shouldRecomputePath(pathGoal) and canAttemptPath then
            lastPathAttempt = now
            local newPath, wpsOrNil = computePathTo(myPos, pathGoal)
            if not newPath then
                if canReachDirectly(myPos, pathGoal, char) then
                    newPath = makeSyntheticDirectPath(myPos, pathGoal)
                    wpsOrNil = newPath:GetWaypoints()
                end
            end
            if newPath then
                pathState.currentPath = newPath
                pathState.currentWaypoints = wpsOrNil
                pathState.currentWaypointIndex = 2
                lastPathTargetPos = pathGoal
                stuckCounter = 0
                lastPathFailed = false
                lastFailedTargetPos = nil
            else
                lastPathFailed = true
                lastFailedTargetPos = targetPos
                local fallbackGoal
                if usedStaging then fallbackGoal = pathGoal
                else
                    local horizDelta = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
                    if horizDelta.Magnitude < 8 then hum:Move(Vector3.zero); return end
                    fallbackGoal = Vector3.new(targetPos.X, myPos.Y, targetPos.Z)
                end
                if canReachDirectly(myPos, fallbackGoal, char) then hum:MoveTo(fallbackGoal)
                else hum:Move(Vector3.zero) end
                lastPathTargetPos = pathGoal
                return
            end
        end

        if not pathState.currentPath or #pathState.currentWaypoints < 2 then return end

        local status, newIdx = executeWaypointPath(
            char, hum, myRoot,
            pathState.currentWaypoints, pathState.currentWaypointIndex, now
        )
        pathState.currentWaypointIndex = newIdx

        if status == "arrived" then
            if canReachDirectly(myPos, targetPos, char) then hum:MoveTo(targetPos) end
            resetPathState()
            return
        end
    end)

    murdererAutoPlayStop = function()
        active = false
        if connection then connection:Disconnect(); connection = nil end
    end
end

-- ===================== INNOCENT TRAIL POOL AUTOPLAY =====================
-- Collects positions from all living players (except murderer and self)
-- into a shared, spatially-bucketed pool. Picks the reachable cell furthest
-- from the murderer and paths there. Repeats continuously.

local trailFollowActive = false
local trailFollowConnection = nil

-- Spatial bucket: keys are "gx_gy_gz" string, values are {pos=Vector3, t=tick()}
local trailPool = {}
local poolLastPrune = 0
local lastScanTime = 0

-- Cell size in studs
local CELL_SIZE = 12
-- Max age of a trail entry before it gets pruned
local POOL_MAX_AGE = 20
-- How often to append (2Hz from each player is enough)
local APPEND_INTERVAL = 0.5
local nextAppend = 0
-- How often to re-scan for the safest cell
local SCAN_INTERVAL = 1.5
-- Max cells to consider before picking
local MAX_CANDIDATES = 30
-- Blacklisted cells: key -> expiry time
local blacklistedCells = {}
local BLACKLIST_COOLDOWN = 5.0

local function cellKey(pos)
    local gx = math.floor(pos.X / CELL_SIZE)
    local gy = math.floor(pos.Y / CELL_SIZE)
    local gz = math.floor(pos.Z / CELL_SIZE)
    return gx .. "_" .. gy .. "_" .. gz
end

local function cellCenter(key)
    -- Reconstruct a representative position — use the stored pos, not the geometric center
    local entry = trailPool[key]
    if entry then return entry.pos end
    return nil
end

local function appendToPool(pos, now)
    local key = cellKey(pos)
    local existing = trailPool[key]
    if not existing or (now - existing.t) > 1 then
        trailPool[key] = { pos = pos, t = now }
    end
end

local function prunePool(now)
    if (now - poolLastPrune) < 2 then return end
    poolLastPrune = now
    local cutoff = now - POOL_MAX_AGE
    for key, entry in pairs(trailPool) do
        if entry.t < cutoff then
            trailPool[key] = nil
        end
    end
    -- Also clear blacklist entries
    for key, expiry in pairs(blacklistedCells) do
        if expiry < now then blacklistedCells[key] = nil end
    end
end

local function collectPositions(now)
    if (now - nextAppend) < APPEND_INTERVAL then return end
    nextAppend = now
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if player.Name == Murder then continue end
        if not player.Character then continue end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        appendToPool(hrp.Position, now)
    end
    -- Also record our own current position so others' pools would include it
    -- (not strictly needed for our own decision-making, but keeps the pool honest)
    local myChar = LocalPlayer.Character
    if myChar then
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if myHrp then appendToPool(myHrp.Position, now) end
    end
end

local function pickSafestCell(murdererPos, myPos)
    local now = tick()
    local candidates = {}
    for key, entry in pairs(trailPool) do
        if (now - entry.t) > POOL_MAX_AGE then continue end
        if blacklistedCells[key] and blacklistedCells[key] > now then continue end
        -- Don't pick the cell we're already in
        if (entry.pos - myPos).Magnitude < CELL_SIZE then continue end
        local d = (entry.pos - murdererPos).Magnitude
        table.insert(candidates, { key = key, pos = entry.pos, dist = d })
    end

    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.dist > b.dist end)

    -- Try the top candidates, pick the first with a valid path
    for i = 1, math.min(MAX_CANDIDATES, #candidates) do
        local cand = candidates[i]
        local path, wps = computePathTo(myPos, cand.pos)
        if path and wps then
            return cand.key, cand.pos, path, wps
        end
        -- No path — blacklist briefly
        blacklistedCells[cand.key] = now + BLACKLIST_COOLDOWN
    end
    return nil
end

local function stopInnocentAutoPlay()
    trailFollowActive = false
    if trailFollowConnection then trailFollowConnection:Disconnect(); trailFollowConnection = nil end
    trailPool = {}
    blacklistedCells = {}
    resetPathState()
end

local function startInnocentAutoPlay()
    if trailFollowActive then return end
    trailFollowActive = true
    trailPool = {}
    blacklistedCells = {}
    poolLastPrune = 0
    lastScanTime = 0
    nextAppend = 0
    resetPathState()
    Notify("Innocent Auto", "Building trail pool, then moving to safest cell", 3)

    local currentTargetPos = nil
    local currentTargetKey = nil
    local lastTargetCheck = 0
    local targetReachedTime = 0

    trailFollowConnection = RunService.Heartbeat:Connect(function()
        if not trailFollowActive then return end

        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local myRoot = char:FindFirstChild("HumanoidRootPart")
        if not hum or not myRoot then return end
        if not canRunAutoplay(char, hum) then
            pcall(function() hum:Move(Vector3.zero) end)
            return
        end

        if hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
        if hum.JumpPower < 50 then hum.JumpPower = 50 end
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)

        local myPos = myRoot.Position
        local now = tick()

        -- Update the pool
        collectPositions(now)
        prunePool(now)

        -- Get murderer position
        local murdererPlayer = Murder and Players:FindFirstChild(Murder)
        if not murdererPlayer or not murdererPlayer.Character then
            hum:Move(Vector3.zero)
            resetPathState()
            return
        end
        local mRoot = murdererPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not mRoot then return end
        local murdererPos = mRoot.Position

        -- If we've reached our current target, or enough time passed, re-scan
        local reachedTarget = currentTargetPos and (myPos - currentTargetPos).Magnitude < 8
        if reachedTarget then
            if (now - targetReachedTime) < 1.0 then
                -- Just arrived, wait a moment before deciding to move again
                if currentTargetPos then
                    -- Stand still on the safe cell
                    hum:Move(Vector3.zero)
                end
                return
            end
        end

        local needScan = (not currentTargetPos)
            or reachedTarget
            or (now - lastScanTime) >= SCAN_INTERVAL
            or (currentTargetPos and (murdererPos - currentTargetPos).Magnitude < 25)

        if needScan then
            lastScanTime = now
            local newKey, newPos, newPath, newWps = pickSafestCell(murdererPos, myPos)
            if newKey then
                currentTargetKey = newKey
                currentTargetPos = newPos
                pathState.currentPath = newPath
                pathState.currentWaypoints = newWps
                pathState.currentWaypointIndex = 2
                targetReachedTime = 0
            else
                -- No reachable cell right now — stand still
                hum:Move(Vector3.zero)
                resetPathState()
                currentTargetPos = nil
                return
            end
        end

        if not currentTargetPos then
            hum:Move(Vector3.zero)
            return
        end

        -- Check if we've arrived
        if (myPos - currentTargetPos).Magnitude < 8 then
            hum:Move(Vector3.zero)
            resetPathState()
            targetReachedTime = now
            return
        end

        -- Execute the path
        if not pathState.currentPath or #pathState.currentWaypoints < 2 then
            -- No path — try re-pathing to current target
            local p, w = computePathTo(myPos, currentTargetPos)
            if p then
                pathState.currentPath = p
                pathState.currentWaypoints = w
                pathState.currentWaypointIndex = 2
            else
                hum:MoveTo(currentTargetPos)
                return
            end
        end

        local status, newIdx = executeWaypointPath(
            char, hum, myRoot,
            pathState.currentWaypoints, pathState.currentWaypointIndex, now
        )
        pathState.currentWaypointIndex = newIdx

        if status == "arrived" then
            if canReachDirectly(myPos, currentTargetPos, char) then
                hum:MoveTo(currentTargetPos)
            end
            resetPathState()
        end
    end)
end

-- ===================== TRAP TRIGGER =====================
local trapQueue = {}
local trapProcessing = false
local trapCooldown = 4.5
local trapTriggerConnection = nil
local function processNextTrap()
    if trapProcessing or #trapQueue == 0 then return end
    trapProcessing = true
    local trapObj = table.remove(trapQueue, 1)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
        trapProcessing = false
        processNextTrap()
        return
    end
    local oldPos = myChar.HumanoidRootPart.CFrame
    local trapPos = nil
    if trapObj:IsA("BasePart") then trapPos = trapObj.Position
    else
        local base = trapObj:FindFirstChildOfClass("BasePart")
        if base then trapPos = base.Position end
    end
    if trapPos then
        myChar.HumanoidRootPart.CFrame = CFrame.new(trapPos + Vector3.new(0, 2, 0))
        task.wait(0.5)
        myChar.HumanoidRootPart.CFrame = oldPos
    end
    trapProcessing = false
    task.wait(trapCooldown)
    processNextTrap()
end
local function startTrapTrigger()
    if trapTriggerConnection then return end
    trapTriggerConnection = Workspace.DescendantAdded:Connect(function(desc)
        if not Config.Helper.TriggerTraps then return end
        local name = string.lower(desc.Name)
        if name:find("trap") and (desc:IsA("BasePart") or desc:IsA("Model")) then
            table.insert(trapQueue, desc)
            processNextTrap()
        end
    end)
end
local function stopTrapTrigger()
    if trapTriggerConnection then trapTriggerConnection:Disconnect(); trapTriggerConnection = nil end
    trapQueue = {}
    trapProcessing = false
end

