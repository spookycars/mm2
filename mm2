    overlay.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    overlay.BorderSizePixel = 0
    overlay.Visible = false
    overlay.ZIndex = 1000
    overlay.Parent = self.ScreenGui

    local overlayCorner = Instance.new("UICorner")
    overlayCorner.CornerRadius = UDim.new(0, 4)
    overlayCorner.Parent = overlay

    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.ScrollBarThickness = 4
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #options * 30)
    scrollFrame.Parent = overlay

    local function refreshOptions()
        for _, child in pairs(scrollFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local newOptions = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then table.insert(newOptions, p.Name) end
        end
        for i, option in ipairs(newOptions) do
            local optionBtn = Instance.new("TextButton")
            optionBtn.Size = UDim2.new(1, 0, 0, 30)
            optionBtn.Position = UDim2.new(0, 0, 0, (i-1) * 30)
            optionBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            optionBtn.BorderSizePixel = 0
            optionBtn.Text = option
            optionBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            optionBtn.Font = Enum.Font.Gotham
            optionBtn.TextSize = 12
            optionBtn.Parent = scrollFrame
            optionBtn.MouseButton1Click:Connect(function()
                dropdown.Text = option
                overlay.Visible = false
                if callback then callback(option) end
                SaveSettings()
            end)
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, #newOptions * 30)
        overlay.Size = UDim2.new(0, 150, 0, #newOptions * 30)
    end
    refreshOptions()

    dropdown.MouseButton1Click:Connect(function()
        overlay.Position = UDim2.new(0, dropdown.AbsolutePosition.X, 0, dropdown.AbsolutePosition.Y + dropdown.AbsoluteSize.Y)
        overlay.Visible = not overlay.Visible
        if overlay.Visible then refreshOptions() end
    end)

    return dropdown
end

