        local firstTarget = nil
        for _, p in pairs(Config.Troll.SelectedTargets) do firstTarget = p; break end
        if not firstTarget then return end
        if firstTarget.Character and firstTarget.Character:FindFirstChild("HumanoidRootPart") then
