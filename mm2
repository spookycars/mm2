-- MAP STRUCTURE DUMP
-- Prints the tree of the currently loaded map so we can find spawns

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "MapDump"
gui.ResetOnSpawn = false
gui.Parent = game:GetService("CoreGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 420, 0, 480)
frame.Position = UDim2.new(0.5, -210, 0.5, -240)
frame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -8, 1, -40)
scroll.Position = UDim2.new(0, 4, 0, 4)
scroll.BackgroundTransparency = 1
scroll.BorderSizePixel = 0
scroll.ScrollBarThickness = 6
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 1)
layout.Parent = scroll

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(1, -8, 0, 28)
closeBtn.Position = UDim2.new(0, 4, 1, -34)
closeBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
closeBtn.Text = "CLOSE + COPY ALL TO CONSOLE"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 12
closeBtn.Parent = frame

local allText = {}
local function log(text, color)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -4, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 10
    lbl.TextColor3 = color or Color3.fromRGB(200, 200, 200)
    lbl.Text = text
    lbl.Parent = scroll
    table.insert(allText, text)
end

-- Find the biggest model/folder in workspace (that's the loaded map)
local biggest, biggestCount = nil, 0
for _, child in ipairs(workspace:GetChildren()) do
    if (child:IsA("Model") or child:IsA("Folder")) and child.Name ~= "Players" then
        local c = #child:GetDescendants()
        if c > biggestCount then
            biggest, biggestCount = child, c
        end
    end
end

if not biggest then
    log("No map model found in workspace", Color3.fromRGB(255, 80, 80))
    return
end

log("=== LOADED MAP: " .. biggest.Name .. " ===", Color3.fromRGB(255, 200, 80))
log("Total descendants: " .. biggestCount, Color3.fromRGB(180, 180, 180))
log("", nil)

-- Dump all direct children of the map
log("--- Direct children of " .. biggest.Name .. " ---", Color3.fromRGB(255, 200, 80))
for _, child in ipairs(biggest:GetChildren()) do
    local count = #child:GetDescendants()
    log(string.format("  [%s] %s  (%d descendants)",
        child.ClassName, child.Name, count), Color3.fromRGB(180, 180, 255))
end

log("", nil)
log("--- Anything containing 'spawn' (case-insensitive) ---", Color3.fromRGB(255, 200, 80))
local found = false
for _, d in ipairs(biggest:GetDescendants()) do
    if string.lower(d.Name):find("spawn") then
        found = true
        local extra = ""
        if d:IsA("BasePart") then
            extra = string.format(" @ (%.0f, %.0f, %.0f)", d.Position.X, d.Position.Y, d.Position.Z)
        end
        log(string.format("  [%s] %s%s", d.ClassName, d:GetFullName(), extra), Color3.fromRGB(120, 220, 120))
    end
end
if not found then
    log("  (none found)", Color3.fromRGB(180, 180, 180))
end

log("", nil)
log("--- Anything containing 'start' or 'respawn' or 'checkpoint' ---", Color3.fromRGB(255, 200, 80))
for _, d in ipairs(biggest:GetDescendants()) do
    local n = string.lower(d.Name)
    if n:find("start") or n:find("respawn") or n:find("checkpoint") or n:find("arrival") or n:find("entry") then
        local extra = ""
        if d:IsA("BasePart") then
            extra = string.format(" @ (%.0f, %.0f, %.0f)", d.Position.X, d.Position.Y, d.Position.Z)
        end
        log(string.format("  [%s] %s%s", d.ClassName, d:GetFullName(), extra), Color3.fromRGB(255, 150, 100))
    end
end

log("", nil)
log("--- Folders/Models at top level of map ---", Color3.fromRGB(255, 200, 80))
for _, child in ipairs(biggest:GetChildren()) do
    if child:IsA("Folder") or child:IsA("Model") then
        log("  " .. child.ClassName .. ": " .. child.Name, Color3.fromRGB(180, 180, 255))
    end
end

log("", nil)
log("--- All BaseParts with unusual names (not 'Part', 'Wall', etc.) ---", Color3.fromRGB(255, 200, 80))
local common = {
    part=true, wall=true, floor=true, ceiling=true, brick=true, block=true,
    wedge=true, cylinder=true, sphere=true, mesh=true, ["union"]=true,
    ["negated"]=true, ["plate"]=true, ["platform"]=true, ["door"]=true,
    ["window"]=true, ["glass"]=true, ["roof"]=true, ["stairs"]=true,
    ["stair"]=true, ["step"]=true, ["railing"]=true, ["support"]=true,
    ["beam"]=true, ["column"]=true, ["floor"]=true
}
for _, d in ipairs(biggest:GetDescendants()) do
    if d:IsA("BasePart") then
        local n = string.lower(d.Name)
        if not common[n] and not n:find("^part") and not n:find("^wall") then
            log(string.format("  [%s] %s @ (%.0f, %.0f, %.0f)",
                d.ClassName, d.Name, d.Position.X, d.Position.Y, d.Position.Z), Color3.fromRGB(150, 150, 200))
        end
    end
end

closeBtn.MouseButton1Click:Connect(function()
    print("=== MAP DUMP ===")
    for _, t in ipairs(allText) do print(t) end
    gui:Destroy()
end)
