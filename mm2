local roles = {}
local Murder, Sheriff, Hero
local MurderPerk = nil

local function updateRolesRemote()
    local getData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if getData then
        local success, result = pcall(function() return getData:InvokeServer() end)
        if success and result then
            roles = result
            Murder, Sheriff, Hero = nil, nil, nil
            for i, v in pairs(roles) do
                if v.Role == "Murderer" then
                    Murder = i
                    MurderPerk = v.Perk or v.MurdererPerk or v.EquippedPerk or nil
                elseif v.Role == "Sheriff" then
                    Sheriff = i
                elseif v.Role == "Hero" then
                    Hero = i
                end
            end
        end
    end
end
local function updateRolesByItems()
    local myChar = LocalPlayer.Character
    local hasKnife = (LocalPlayer.Backpack:FindFirstChild("Knife") ~= nil) or (myChar and myChar:FindFirstChild("Knife") ~= nil)
    local hasGun = (LocalPlayer.Backpack:FindFirstChild("Gun") ~= nil) or (myChar and myChar:FindFirstChild("Gun") ~= nil)
    if hasKnife then
        Murder = LocalPlayer.Name; Sheriff, Hero = nil, nil
    elseif hasGun then
        Sheriff = LocalPlayer.Name; Murder, Hero = nil, nil
    else
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                local pKnife = player.Backpack:FindFirstChild("Knife") or (char and char:FindFirstChild("Knife"))
                local pGun = player.Backpack:FindFirstChild("Gun") or (char and char:FindFirstChild("Gun"))
                if pKnife then Murder = player.Name
                elseif pGun then Sheriff = player.Name end
            end
        end
    end
end
local function updateRoles()
    updateRolesRemote()
    if not Murder or not Sheriff then updateRolesByItems() end
end
local function IsAlive(player)
    local data = roles[player.Name]
    if data and (data.Killed == true or data.Dead == true) then return false end
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then return hum.Health > 0 end
    end
    return true
end
local function getRole(player)
    if player.Name == Murder then return "Murderer", Color3.fromRGB(255, 50, 50)
    elseif player.Name == Sheriff or player.Name == Hero then return "Sheriff", Color3.fromRGB(50, 50, 255)
    elseif player.Backpack:FindFirstChild("Knife") or (player.Character and player.Character:FindFirstChild("Knife")) then return "Murderer", Color3.fromRGB(255, 50, 50)
    elseif player.Backpack:FindFirstChild("Gun") or (player.Character and player.Character:FindFirstChild("Gun")) then return "Sheriff", Color3.fromRGB(50, 50, 255) end
    return "Innocent", Color3.fromRGB(0, 225, 0)
end

local antiFlingConnection = nil
local function toggleAntiFling(enabled)
    if antiFlingConnection then antiFlingConnection:Disconnect(); antiFlingConnection = nil end
    if enabled then
        antiFlingConnection = RunService.Stepped:Connect(function()
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    for _, v in pairs(player.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end
        end)
    end
end
local OrgDestroyHeight = Workspace.FallenPartsDestroyHeight
local antiVoidConnection = nil
local function toggleAntiVoid(enabled)
    if antiVoidConnection then antiVoidConnection:Disconnect(); antiVoidConnection = nil end
    if enabled then
        antiVoidConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if root and root.Position.Y <= OrgDestroyHeight + 25 then
                    root.Velocity = root.Velocity + Vector3.new(0, 250, 0)
                end
            end
        end)
    end
end
if Config.Visuals.AntiFling then toggleAntiFling(true) end
if Config.Visuals.AntiVoid then toggleAntiVoid(true) end
LocalPlayer.CharacterAdded:Connect(function()
    if Config.Visuals.AntiFling then toggleAntiFling(true) end
    if Config.Visuals.AntiVoid then toggleAntiVoid(true) end
end)

