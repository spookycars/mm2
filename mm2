local trapQueue = {}
local trapProcessing = false
local trapCooldown = 4.5
local trapTriggerConnection = nil
local function processNextTrap()
    if trapProcessing or #trapQueue == 0 then return end
    trapProcessing = true
    local trapObj = table.remove(trapQueue, 1)
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then
        trapProcessing = false
        processNextTrap()
        return
    end
    local oldPos = myChar.HumanoidRootPart.CFrame
    local trapPos = nil
    if trapObj:IsA("BasePart") then trapPos = trapObj.Position
    else
        local base = trapObj:FindFirstChildOfClass("BasePart")
        if base then trapPos = base.Position end
    end
    if trapPos then
        myChar.HumanoidRootPart.CFrame = CFrame.new(trapPos + Vector3.new(0, 2, 0))
        task.wait(0.5)
        myChar.HumanoidRootPart.CFrame = oldPos
    end
    trapProcessing = false
    task.wait(trapCooldown)
    processNextTrap()
end
local function startTrapTrigger()
    if trapTriggerConnection then return end
    trapTriggerConnection = Workspace.DescendantAdded:Connect(function(desc)
        if not Config.Helper.TriggerTraps then return end
        local name = string.lower(desc.Name)
        if name:find("trap") and (desc:IsA("BasePart") or desc:IsA("Model")) then
            table.insert(trapQueue, desc)
            processNextTrap()
        end
    end)
end
local function stopTrapTrigger()
    if trapTriggerConnection then trapTriggerConnection:Disconnect(); trapTriggerConnection = nil end
    trapQueue = {}
    trapProcessing = false
end

getgenv().OldPos = nil
getgenv().FPDH = workspace.FallenPartsDestroyHeight
local FlingActive = false
local flingLoopThread = nil

local function Message(Title, Text, Time) Notify(Title, Text, Time or 3) end

local function SkidFling(TargetPlayer)
    local Player = LocalPlayer
    local Character = Player.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    if not TCharacter then return end
    local THumanoid, TRootPart, THead, Accessory, Handle
    if TCharacter:FindFirstChildOfClass("Humanoid") then THumanoid = TCharacter:FindFirstChildOfClass("Humanoid") end
    if THumanoid and THumanoid.RootPart then TRootPart = THumanoid.RootPart end
    if TCharacter:FindFirstChild("Head") then THead = TCharacter.Head end
    if TCharacter:FindFirstChildOfClass("Accessory") then Accessory = TCharacter:FindFirstChildOfClass("Accessory") end
    if Accessory and Accessory:FindFirstChild("Handle") then Handle = Accessory.Handle end
    if Character and Humanoid and RootPart then
        if RootPart.Velocity.Magnitude < 50 then getgenv().OldPos = RootPart.CFrame end
        if THumanoid and THumanoid.Sit then return Message("Error", TargetPlayer.Name .. " is sitting", 2) end
        if THead then workspace.CurrentCamera.CameraSubject = THead
        elseif Handle then workspace.CurrentCamera.CameraSubject = Handle
        elseif THumanoid and TRootPart then workspace.CurrentCamera.CameraSubject = THumanoid end
        if not TCharacter:FindFirstChildWhichIsA("BasePart") then return end
        local FPos = function(BasePart, Pos, Ang)
            RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
            Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
            RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
            RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end
        local SFBasePart = function(BasePart)
            local TimeToWait = 2
            local Time = tick()
            local Angle = 0
            repeat
                if RootPart and THumanoid then
                    if BasePart.Velocity.Magnitude < 50 then
                        Angle = Angle + 100
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection * BasePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                    else
                        FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, -THumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, THumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                        task.wait()
                    end
                end
            until Time + TimeToWait < tick() or not FlingActive
        end
        workspace.FallenPartsDestroyHeight = 0 / 0
        local BV = Instance.new("BodyVelocity")
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(0, 0, 0)
        BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        if TRootPart then SFBasePart(TRootPart)
        elseif THead then SFBasePart(THead)
        elseif Handle then SFBasePart(Handle)
        else return Message("Error", TargetPlayer.Name .. " has no valid parts", 2) end
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        workspace.CurrentCamera.CameraSubject = Humanoid
        if getgenv().OldPos then
            repeat
                RootPart.CFrame = getgenv().OldPos * CFrame.new(0, 0.5, 0)
                Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, 0.5, 0))
                Humanoid:ChangeState("GettingUp")
                for _, part in pairs(Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                    end
                end
                task.wait()
            until (RootPart.Position - getgenv().OldPos.p).Magnitude < 25
            workspace.FallenPartsDestroyHeight = getgenv().FPDH
        end
    else
        return Message("Error", "Your character is not ready", 2)
    end
end

local function countSelectedTargets()
    local count = 0
    for _ in pairs(Config.Troll.SelectedTargets) do count = count + 1 end
    return count
end

local function startFlingLoop()
    if FlingActive then return end
    if countSelectedTargets() == 0 then Notify("Troll", "No targets selected", 3); return end
    FlingActive = true
    Notify("Fling", "Started - flinging " .. countSelectedTargets() .. " target(s)", 2)
    flingLoopThread = task.spawn(function()
        while FlingActive do
            local validTargets = {}
            for name, player in pairs(Config.Troll.SelectedTargets) do
                if player and player.Parent then validTargets[name] = player
                else Config.Troll.SelectedTargets[name] = nil end
            end
            for _, player in pairs(validTargets) do
                if not FlingActive then break end
                SkidFling(player)
                task.wait(0.1)
            end
            task.wait(0.5)
        end
    end)
end
local function stopFlingLoop()
    if not FlingActive then return end
    FlingActive = false
    Notify("Fling", "Stopped", 2)
    pcall(function() workspace.FallenPartsDestroyHeight = getgenv().FPDH end)
end

local loopGoToConnection = nil
local function startLoopGoTo()
    if loopGoToConnection then return end
    loopGoToConnection = RunService.Heartbeat:Connect(function()
        if not Config.Troll.LoopGoToEnabled then stopLoopGoTo(); return end
        local firstTarget = nil
        for _, p in pairs(Config.Troll.SelectedTargets) do firstTarget = p; break end
        if not firstTarget then return end
        if firstTarget.Character and firstTarget.Character:FindFirstChild("HumanoidRootPart") then
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                myChar.HumanoidRootPart.CFrame = firstTarget.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 3)
            end
        end
    end)
end
local function stopLoopGoTo()
    if loopGoToConnection then loopGoToConnection:Disconnect(); loopGoToConnection = nil end
    Config.Troll.LoopGoToEnabled = false
end

