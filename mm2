-- ===================== KILL SCRIPT =====================
local connections = {}
local threads = {}
local scriptKilled = false

function addConnection(conn)
    table.insert(connections, conn)
    return conn
end

function addThread(t)
    table.insert(threads, t)
    return t
end

function killScript()
    scriptKilled = true
    stopAutoPlay()
    stopFlingLoop()
    stopLoopGoTo()
    stopTrapTrigger()
    destroySpawnBarrier()
    stopSpectating()
    for _, conn in ipairs(connections) do
        pcall(function() conn:Disconnect() end)
    end
    for _, t in ipairs(threads) do
        pcall(function() task.cancel(t) end)
    end
    pcall(function() UI.ScreenGui:Destroy() end)
    if Config.Visuals.FullBright then
        Lighting.Brightness = 1
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1000
        Lighting.GlobalShadows = true
    end
    Notify("Script Killed", "MM2 Script has been unloaded.")
end

-- ===================== UPDATE LOOPS =====================
addThread(task.spawn(function()
    while not scriptKilled do
        wait(1)
        pcall(updateRoles)
    end
end))

addThread(task.spawn(function()
    while not scriptKilled do
        wait(0.3)
        pcall(updateESP)
    end
end))

addThread(task.spawn(function()
    while not scriptKilled do
        wait(0.5)
        pcall(updateHelper)
    end
end))

addThread(task.spawn(function()
    while not scriptKilled do
        wait(0.1)
        if Config.Combat.AutoGrabGun then autoGrabGun() end
    end
end))

addConnection(RunService.Stepped:Connect(function()
    if scriptKilled then return end
    if Config.Movement.Noclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end))

addConnection(Players.PlayerAdded:Connect(function(player)
    if savedData.SelectedPlayer and player.Name == savedData.SelectedPlayer then
        Config.Helper.SelectedPlayer = player
    end
end))

addThread(task.spawn(function()
    while not scriptKilled do
        wait(5)
        SaveSettings()
    end
end))

